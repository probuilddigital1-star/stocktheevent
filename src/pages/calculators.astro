---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { items } from '../data/items';
import { events } from '../data/events';
import { drinkShare } from '../data/eventSplits';

// One-line note per occasion, derived from the split data: the leading drink
// (or the leading pair when the bar is balanced) and the default run time.
function occasionNote(event: (typeof events)[number]): string {
  const shares = items
    .map((item) => ({ item, share: drinkShare(event.id, item.id) }))
    .sort((a, b) => b.share - a.share);
  const [top, second] = shares;
  const lead =
    top.share >= second.share * 1.4
      ? `${top.item.name.toLowerCase()} forward`
      : `${top.item.name.toLowerCase()} and ${second.item.name.toLowerCase()}`;
  return `${lead} · ${event.defaultDuration} hours`;
}

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Drink Calculators', url: '/calculators/' },
];
---

<BaseLayout
  title="Drink and Occasion Calculators | StockTheEvent"
  description="Drink calculators for any event. Pick an occasion or a drink to see exactly how much wine, beer, champagne, or spirits you need for weddings, parties, and more."
  breadcrumbs={breadcrumbs}
>
  <section class="container index-hero">
    <nav class="index-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span>Calculators</span>
    </nav>
    <h1 class="index-h1">Every occasion, every drink</h1>
    <p class="index-deck">
      Pick your occasion for the full bar, or a drink for its numbers across
      every event. Each page shows the arithmetic behind its answer.
    </p>
  </section>

  <section class="container index-section">
    <div class="rule"></div>
    <div class="section-grid index-grid">
      <div class="section-head">
        <span class="label index-label">By occasion</span>
        <h2 class="index-title">All {events.length} occasions</h2>
        <p class="index-note">
          Each occasion has its own split across the four drinks and its own
          pace.
        </p>
      </div>
      <div class="section-body occasion-index">
        {events.map((event) => (
          <a href={`/calculators/${event.id}/`} class="occasion-row">
            <span>{event.name}</span>
            <span class="occasion-note">{occasionNote(event)}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="container index-section">
    <div class="rule"></div>
    <div class="section-grid index-grid">
      <div class="section-head">
        <span class="label index-label">By drink</span>
        <h2 class="index-title">One drink at a time</h2>
        <p class="index-note">
          Every figure is that drink's share of a full bar, with the only-drink
          figure alongside it.
        </p>
      </div>
      <div class="section-body drink-index">
        {items.map((item) => (
          <a href={`/calculators/${item.id}/`} class="drink-row">
            <Icon name={item.icon} size={22} />
            <span class="drink-row-name">{item.name}</span>
            <span class="num drink-row-note">{item.servingsPerUnit} servings per {item.unitSingular}</span>
            <Icon name="arrow" size={18} />
          </a>
        ))}
        <a href="/bar-setup/" class="drink-row drink-row-all">
          <span class="drink-row-name">All four together, the full bar</span>
          <Icon name="arrow" size={18} />
        </a>
        <a href="/food/" class="drink-row drink-row-all">
          <span class="drink-row-name">Food calculators</span>
          <Icon name="arrow" size={18} />
        </a>
      </div>
    </div>
  </section>

  <section class="container index-section">
    <div class="rule"></div>
    <p class="index-method">
      Every number here comes from the same model, explained in full on the
      <a href="/methodology/">methodology page</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .index-hero {
    padding-top: 40px;
    padding-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .index-crumbs {
    display: flex;
    gap: 10px;
    font-size: 13px;
    color: var(--ink-2);
  }

  .index-crumbs a,
  .index-crumbs span {
    color: var(--ink-2);
  }

  .index-h1 {
    margin: 0;
    font-size: 36px;
    line-height: 1.06;
  }

  @media (min-width: 900px) {
    .index-h1 {
      font-size: 56px;
    }
  }

  .index-deck {
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 48ch;
  }

  .index-section {
    padding-bottom: 56px;
  }

  .index-grid {
    padding-top: 32px;
  }

  .index-label {
    color: var(--accent);
  }

  .index-title {
    margin: 0;
    font-size: 26px;
    line-height: 1.15;
  }

  @media (min-width: 900px) {
    .index-title {
      font-size: 32px;
    }
  }

  .index-note {
    margin: 0;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.55;
    max-width: 30ch;
  }

  .occasion-index {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 48px;
  }

  @media (min-width: 700px) {
    .occasion-index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .occasion-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-size: 17px;
  }

  .occasion-note {
    font-size: 13px;
    color: var(--ink-2);
    text-align: right;
  }

  .drink-index {
    display: flex;
    flex-direction: column;
  }

  .drink-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-size: 17px;
  }

  .drink-row-name {
    flex: 1;
  }

  .drink-row-note {
    font-size: 13px;
    color: var(--ink-2);
  }

  .drink-row-all {
    color: var(--accent);
    font-weight: 500;
  }

  .index-method {
    margin: 32px 0 0;
    font-size: 14px;
    color: var(--ink-2);
  }
</style>
