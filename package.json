{
  "name": "stocktheevent",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "predev": "npm run generate",
    "dev": "astro dev",
    "build": "npm run generate && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate": "tsx scripts/generateData.ts && tsx scripts/generateFoodData.ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "check": "tsx scripts/checkSite.ts",
    "deploy": "npm run build && npm run check && tsx scripts/ops/deploy.ts",
    "deploy:preview": "npm run build && npm run check && tsx scripts/ops/deploy.ts --branch redesign-a",
    "verify:live": "tsx scripts/ops/verifyLive.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.16.6",
    "googleapis": "^176.0.0",
    "posthog-js": "^1.419.4",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "tsx": "^4.19.0"
  }
}
