---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HubTable from '../../components/HubTable.astro';
import type { HubRow } from '../../components/HubTable.astro';
import { items } from '../../data/items';
import { events } from '../../data/events';
import { foodItems } from '../../data/foodItems';
import { INDEXABLE_GUEST_COUNTS } from '../../data/indexing';
import { drinkPage, foodPage, fullBarTotals, slugFor } from '../../lib/pageData';
import { DRINK_HUB_QUESTION, hubIntro } from '../../data/hubCopy';

export function getStaticPaths() {
  return [
    ...items.map((item) => ({ params: { category: item.id }, props: { type: 'item' as const, itemId: item.id } })),
    ...events.map((event) => ({ params: { category: event.id }, props: { type: 'event' as const, eventId: event.id } })),
  ];
}

const props = Astro.props as
  | { type: 'item'; itemId: string }
  | { type: 'event'; eventId: string };

const GUESTS = INDEXABLE_GUEST_COUNTS;
const ANCHOR = 100;

let h1: string;
let title: string;
let description: string;
let intro: string;
let breadcrumbLabel: string;
let breadcrumbUrl: string;

// Drink hub: one table, 13 events by 6 guest counts, showing this drink's
// full-bar quantity. Event hub: two tables, drinks and foods.
let drinkRows: HubRow[] = [];
let foodRows: HubRow[] = [];
let tableCaption = '';
let foodTableCaption = '';
let eventTips: string[] = [];
let barSetupHref = '';
let barSetupSummary = '';

if (props.type === 'item') {
  const item = items.find((i) => i.id === props.itemId)!;
  const anchor = drinkPage(item.id, 'wedding', ANCHOR);

  h1 = DRINK_HUB_QUESTION[item.id];
  title = `${h1} Calculator for 25 to 200 Guests | StockTheEvent`;
  description = `${item.name} for ${ANCHOR} wedding guests on a full bar is ${anchor!.calculation.fullBar.unitsNeeded} ${anchor!.calculation.fullBar.unitsDisplay}. Quantities for every event at 25 to 200 guests.`;
  intro = hubIntro(`drink:${item.id}`);
  breadcrumbLabel = item.name;
  breadcrumbUrl = `/calculators/${item.id}/`;
  tableCaption = `${item.name} on a full bar, by event and guest count`;

  drinkRows = events.map((event) => ({
    label: event.name,
    href: `/calculators/${event.id}/`,
    cells: GUESTS.map((guests) => {
      const page = drinkPage(item.id, event.slug, guests);
      return page
        ? {
            label: `${page.calculation.fullBar.unitsNeeded} ${page.calculation.fullBar.unitsDisplay}`,
            href: `/${slugFor(item.id, event.slug, guests)}/`,
          }
        : { label: null, href: null };
    }),
  }));
} else {
  const event = events.find((e) => e.id === props.eventId)!;
  const totals = fullBarTotals(items.map((i) => i.id), event.slug, ANCHOR);

  h1 = `${event.name} Drink and Food Calculator`;
  title = `${h1}: 25 to 200 Guests | StockTheEvent`;
  description = `A ${ANCHOR}-guest ${event.lowerName} needs about ${totals!.servings} drinks across a full bar. Wine, beer, spirits, champagne and six foods at 25 to 200 guests.`;
  intro = hubIntro(`event:${event.id}`);
  breadcrumbLabel = event.name;
  breadcrumbUrl = `/calculators/${event.id}/`;
  tableCaption = `Drinks for a ${event.lowerName}, by guest count`;
  foodTableCaption = `Food for a ${event.lowerName}, by guest count`;

  drinkRows = items.map((item) => ({
    label: item.name,
    href: `/calculators/${item.id}/`,
    cells: GUESTS.map((guests) => {
      const page = drinkPage(item.id, event.slug, guests);
      return page
        ? {
            label: `${page.calculation.fullBar.unitsNeeded} ${page.calculation.fullBar.unitsDisplay}`,
            href: `/${slugFor(item.id, event.slug, guests)}/`,
          }
        : { label: null, href: null };
    }),
  }));

  foodRows = foodItems.map((food) => ({
    label: food.name,
    href: `/food/${food.id}/`,
    cells: GUESTS.map((guests) => {
      const page = foodPage(food.id, event.slug, guests);
      return page
        ? {
            label: `${page.calculation.unitsNeeded} ${page.calculation.unitsDisplay}`,
            href: `/food/${slugFor(food.id, event.slug, guests)}/`,
          }
        : { label: null, href: null };
    }),
  }));

  // The tips in src/data/events.ts are already plain guidance; the fabricated
  // statistics they used to carry were rewritten at the source.
  eventTips = event.proTips.slice(0, 2);
  barSetupHref = `/bar-setup/${event.slug}-${ANCHOR}-guests/`;
  // Drinks, not a combined unit count: bottles and cases are not the same thing.
  barSetupSummary = `About ${totals!.servings} drinks`;
}

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Calculators', url: '/calculators/' },
  { name: breadcrumbLabel, url: breadcrumbUrl },
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <section class="hub">
    <div class="hub-inner">
      <nav class="hub-crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/calculators/">Calculators</a>
        <span aria-hidden="true">/</span>
        <span>{breadcrumbLabel}</span>
      </nav>

      <h1 class="hub-h1">{h1}</h1>

      {intro.split('\n\n').map((para) => <p class="hub-intro">{para}</p>)}

      {props.type === 'event' && (
        <p class="hub-callout">
          <a href={barSetupHref}>See the whole bar for a {events.find((e) => e.id === props.eventId)!.lowerName} at {ANCHOR} guests</a>
          <span class="hub-callout-note">{barSetupSummary}, wine, beer, spirits and champagne together.</span>
        </p>
      )}

      <HubTable
        caption={tableCaption}
        rowHeading={props.type === 'item' ? 'Event' : 'Drink'}
        columns={GUESTS}
        rows={drinkRows}
        footnote="Every figure is that drink's share of a full bar, with a 15 percent buffer included. Each page also shows what you would need if it were the only alcohol served."
      />

      {props.type === 'event' && (
        <div class="hub-second-table">
          <HubTable
            caption={foodTableCaption}
            rowHeading="Food"
            columns={GUESTS}
            rows={foodRows}
            footnote="Food figures assume that dish is the main food. Serving several dishes together lowers each one."
          />
        </div>
      )}

      {eventTips.length > 0 && (
        <div class="hub-tips">
          <h2 class="hub-h2">Planning notes</h2>
          <ul>
            {eventTips.map((tip) => <li>{tip}</li>)}
          </ul>
        </div>
      )}

      <div class="hub-links">
        <h2 class="hub-h2">Food calculators</h2>
        <ul class="hub-link-list">
          {foodItems.map((food) => (
            <li><a href={`/food/${food.id}/`}>{food.name}</a></li>
          ))}
        </ul>
      </div>

      {props.type === 'item' && (
        <div class="hub-links">
          <h2 class="hub-h2">Other drinks</h2>
          <ul class="hub-link-list">
            {items.filter((i) => i.id !== props.itemId).map((item) => (
              <li><a href={`/calculators/${item.id}/`}>{item.name}</a></li>
            ))}
            <li><a href="/bar-setup/">All four together</a></li>
          </ul>
        </div>
      )}

      <p class="hub-method">
        Every number here comes from the same model, explained in full on the
        <a href="/methodology/">methodology page</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hub {
    padding: 3rem 0 4rem;
  }

  .hub-inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .hub-crumbs {
    font-size: 0.8125rem;
    color: var(--ink-2, #4B524E);
    margin-bottom: 1.5rem;
  }

  .hub-crumbs span {
    margin: 0 0.5rem;
  }

  .hub-h1 {
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  .hub-h2 {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .hub-intro {
    max-width: 44rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .hub-callout {
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--rule, #C7CDC8);
    background: var(--paper-2, #ECEEE9);
  }

  .hub-callout a {
    font-weight: 600;
  }

  .hub-callout-note {
    display: block;
    font-size: 0.875rem;
    color: var(--ink-2, #4B524E);
    margin-top: 0.25rem;
  }

  .hub-second-table {
    margin-top: 2rem;
  }

  .hub-tips {
    margin-top: 2.5rem;
    max-width: 44rem;
  }

  .hub-tips ul {
    list-style: disc;
    padding-left: 1.25rem;
  }

  .hub-tips li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .hub-links {
    margin-top: 2.5rem;
  }

  .hub-link-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    padding: 0;
  }

  .hub-method {
    margin-top: 2.5rem;
    font-size: 0.875rem;
    color: var(--ink-2, #4B524E);
  }
</style>
