---
import type { ShoppingItem } from '../lib/types';

interface Props {
  eventType?: string;
  placement?: 'inline' | 'footer';
  shoppingList?: ShoppingItem[];
  eventName?: string;
  guestCount?: number;
}
const {
  eventType = 'general',
  placement = 'inline',
  shoppingList = [],
  eventName = '',
  guestCount = 0
} = Astro.props;

// Serialize shopping list for the form
const shoppingListJson = JSON.stringify(shoppingList);

const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<div class="email-capture">
  <h3 class="font-display email-title">
    {shoppingList.length > 0 ? 'Email your shopping list' : 'Planning notes by email'}
  </h3>
  <p class="email-note">
    {shoppingList.length > 0
      ? 'We will send the complete list to your inbox.'
      : 'Occasional planning notes, nothing more.'}
  </p>
  <form id="email-form" class="email-form">
    <label class="label" for="email-capture-input">Email address</label>
    <div class="email-row">
      <input
        type="email"
        id="email-capture-input"
        name="email"
        placeholder="you@example.com"
        required
        class="field"
      />
      <button type="submit" class="btn-primary">
        {shoppingList.length > 0 ? 'Send my list' : 'Sign up'}
      </button>
    </div>
    <input type="hidden" name="eventType" value={eventType} />
    <input type="hidden" name="eventName" value={eventName} />
    <input type="hidden" name="guestCount" value={guestCount} />
    <input type="hidden" name="source" value={placement} />
    <input type="hidden" name="shoppingList" value={shoppingListJson} />
    <input type="hidden" name="pageUrl" id="page-url" value="" />
    {/* Honeypot: visually hidden (not display:none, so simple bots that skip
        display:none fields still fall for it), not tab-reachable, and
        aria-hidden so screen reader users never encounter it. A real
        visitor never fills this in. */}
    <div class="visually-hidden" aria-hidden="true">
      <label for="email-capture-hp">Leave this field blank</label>
      <input type="text" id="email-capture-hp" name="website" autocomplete="off" tabindex="-1" />
    </div>
    <input type="hidden" id="email-capture-started-at" name="formStartedAt" value="" />
    {TURNSTILE_SITE_KEY && (
      <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>
    )}
  </form>
  <p id="form-message" class="email-note hidden"></p>
  <p class="email-fine">No spam, unsubscribe anytime.</p>
</div>

<style>
  .email-capture {
    border: 1px solid var(--rule);
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .email-title {
    margin: 0;
    font-size: 20px;
    font-weight: 400;
  }

  .email-note {
    margin: 0;
    font-size: 14px;
    color: var(--ink-2);
  }

  .email-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .email-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .email-row .field {
    flex: 1;
    min-width: 200px;
  }

  .email-fine {
    margin: 0;
    font-size: 12px;
    color: var(--ink-2);
  }
</style>

<script>
  import { track } from '../lib/track';

  // The n8n workflow should verify turnstileToken against Cloudflare's
  // siteverify endpoint (https://challenges.cloudflare.com/turnstile/v0/siteverify)
  // once PUBLIC_TURNSTILE_SITE_KEY is set; this form only forwards the token.

  // Set the page URL on load
  const pageUrlInput = document.getElementById('page-url') as HTMLInputElement;
  if (pageUrlInput) {
    pageUrlInput.value = window.location.href;
  }

  const startedAtInput = document.getElementById('email-capture-started-at') as HTMLInputElement;
  if (startedAtInput) {
    startedAtInput.value = String(Date.now());
  }

  const form = document.getElementById('email-form');
  const message = document.getElementById('form-message');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    message?.classList.add('hidden');
    const formData = new FormData(form as HTMLFormElement);
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalBtnText = submitBtn?.textContent ?? '';

    // Bot defense: a filled honeypot or a submit under 3 seconds after the
    // form appeared drops the request client-side before it ever reaches
    // the network. honeypot/elapsedMs still ride along on genuine
    // submissions so the n8n workflow can apply the same check server-side.
    const honeypot = String(formData.get('website') || '');
    const startedAt = Number(formData.get('formStartedAt') || 0);
    const elapsedMs = Date.now() - startedAt;
    if (honeypot || elapsedMs < 3000) {
      return;
    }

    // Set loading state
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
    }

    // Build the payload
    const payload: Record<string, unknown> = {
      email: formData.get('email'),
      eventType: formData.get('eventType'),
      eventName: formData.get('eventName'),
      guestCount: formData.get('guestCount'),
      source: formData.get('source'),
      pageUrl: formData.get('pageUrl'),
      timestamp: new Date().toISOString(),
      honeypot,
      elapsedMs,
      turnstileToken: formData.get('cf-turnstile-response') || undefined,
    };

    // Parse shopping list if present
    const shoppingListStr = formData.get('shoppingList') as string;
    if (shoppingListStr && shoppingListStr !== '[]') {
      try {
        payload.shoppingList = JSON.parse(shoppingListStr);
      } catch {
        payload.shoppingList = [];
      }
    }

    track('email_submit', { source: formData.get('source'), event: formData.get('eventType') });

    try {
      const response = await fetch('https://zax76.app.n8n.cloud/webhook/email-signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (response.ok) {
        if (message) {
          message.textContent = 'Check your inbox!';
        }
        (form as HTMLFormElement).reset();
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalBtnText;
        }
      } else {
        throw new Error('Failed');
      }
    } catch (err) {
      if (message) {
        message.textContent = 'Something went wrong. Try again?';
      }
      // Re-enable button on error so user can retry
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalBtnText;
      }
    }
    message?.classList.remove('hidden');
  });
</script>
