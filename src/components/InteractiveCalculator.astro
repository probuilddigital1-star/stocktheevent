---
/**
 * InteractiveCalculator.astro - the homepage calculator, rendered as a
 * bordered ledger. Inputs on the left (drink toggles, occasion select,
 * guest and hour steppers), the resulting bar as a table on the right.
 *
 * Model constants come from src/data/model.ts and drink splits from
 * src/data/eventSplits.ts via define:vars, so this calculator, the
 * bar-setup pages, and the generator all read one source.
 */
import Icon from './Icon.astro';
import { items } from '../data/items';
import { events } from '../data/events';
import { EVENT_SPLITS } from '../data/eventSplits';
import {
  BASE_DRINKS_PER_HOUR,
  BUFFER_PERCENTAGE,
  HOURLY_DECAY,
  DRINKING_PERCENTAGE,
} from '../data/model';

const itemsData = items.map(i => ({
  id: i.id,
  name: i.name,
  icon: i.icon,
  unit: i.unit,
  unitSingular: i.unitSingular,
  servingsPerUnit: i.servingsPerUnit,
}));

const eventsData = events.map(e => ({
  id: e.id,
  name: e.name,
  pluralName: e.pluralName,
  slug: e.slug,
  defaultDuration: e.defaultDuration,
  modifiers: e.modifiers,
}));

const DEFAULT_GUESTS = 100;
const DEFAULT_HOURS = events[0].defaultDuration;
---

<div class="calc-box" id="calculator">
  <div class="calc-head">
    <span class="label calc-head-title">The calculator</span>
    <span class="label">Results update as you type</span>
  </div>

  <div class="calc-grid">
    <!-- Inputs -->
    <div class="calc-inputs">
      <fieldset class="calc-field">
        <legend class="label">What are you serving</legend>
        <div class="drink-toggle-grid" id="item-selector">
          {items.map((item) => (
            <button
              type="button"
              class="drink-toggle"
              data-item={item.id}
              aria-pressed="true"
            >
              <Icon name={item.icon} size={24} />
              <span>{item.name}</span>
            </button>
          ))}
        </div>
      </fieldset>

      <div class="calc-field">
        <label class="label" for="event-select">Occasion</label>
        <select id="event-select" class="field">
          {events.map(event => (
            <option value={event.id}>{event.name}</option>
          ))}
        </select>
      </div>

      <div class="calc-steppers">
        <div class="calc-field">
          <label class="label" for="guest-input">Guests</label>
          <div class="stepper" id="guest-stepper">
            <button type="button" data-step="down" aria-label="Fewer guests">
              <Icon name="minus" size={18} />
            </button>
            <input
              type="number"
              id="guest-input"
              value={DEFAULT_GUESTS}
              min="10"
              max="300"
              inputmode="numeric"
              aria-valuetext={`${DEFAULT_GUESTS} guests`}
            />
            <button type="button" data-step="up" aria-label="More guests">
              <Icon name="plus" size={18} />
            </button>
          </div>
        </div>
        <div class="calc-field">
          <label class="label" for="duration-input">Hours</label>
          <div class="stepper" id="duration-stepper">
            <button type="button" data-step="down" aria-label="Fewer hours">
              <Icon name="minus" size={18} />
            </button>
            <input
              type="number"
              id="duration-input"
              value={DEFAULT_HOURS}
              min="1"
              max="6"
              inputmode="numeric"
              aria-valuetext={`${DEFAULT_HOURS} hours`}
            />
            <button type="button" data-step="up" aria-label="More hours">
              <Icon name="plus" size={18} />
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Your bar -->
    <div class="calc-results">
      <div class="calc-results-head">
        <span class="label calc-head-title">Your bar</span>
        <span class="num calc-context" id="calc-context">{DEFAULT_GUESTS} guests · {DEFAULT_HOURS} hours</span>
      </div>

      <table class="bar-table" id="bar-table">
        <tbody>
          {items.map((item) => (
            <tr data-drink-id={item.id}>
              <td class="bar-icon"><Icon name={item.icon} size={20} /></td>
              <td class="bar-name">{item.name}</td>
              <td class="num bar-units">
                <span class="bar-value drink-units"></span><span class="bar-unit drink-unit-label">{item.unit}</span>
              </td>
            </tr>
          ))}
          <tr class="bar-total-row">
            <td></td>
            <td>Servings in total</td>
            <td class="num bar-units">
              <span class="bar-value" id="bar-total"></span><span class="bar-unit">drinks</span>
            </td>
          </tr>
        </tbody>
      </table>

      <p class="calc-note" id="calc-note"></p>

      <a href="#" id="detail-link" class="btn-primary calc-cta">
        <span id="cta-text">See the full breakdown and shopping list</span>
        <Icon name="arrow" size={20} />
      </a>
    </div>
  </div>
</div>

<style>
  .calc-box {
    border: 1px solid var(--ink);
    background: var(--paper);
  }

  .calc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 28px;
    border-bottom: 1px solid var(--ink);
  }

  .calc-head-title {
    color: var(--ink);
  }

  .calc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 700px) {
    .calc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .calc-inputs {
      border-right: 1px solid var(--rule);
    }
  }

  .calc-inputs {
    padding: 28px 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .calc-field {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 0;
    padding: 0;
    margin: 0;
  }

  .calc-field legend {
    padding: 0;
    margin-bottom: 10px;
  }

  .drink-toggle-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .drink-toggle {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink-2);
    font-weight: 500;
    font-size: 16px;
    cursor: pointer;
    min-height: 44px;
  }

  .drink-toggle[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--accent-soft);
    color: var(--ink);
  }

  .calc-steppers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .calc-results {
    padding: 28px 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .calc-results-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .calc-context {
    font-size: 13px;
    color: var(--ink-2);
  }

  .bar-table {
    border-collapse: collapse;
    width: 100%;
  }

  .bar-table td {
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: middle;
  }

  .bar-icon {
    width: 32px;
    color: var(--ink);
  }

  .bar-units {
    text-align: right;
  }

  .bar-value {
    font-size: 22px;
    font-weight: 600;
  }

  .bar-unit {
    margin-left: 0.35em;
    font-size: 16px;
    font-weight: 400;
    color: var(--ink-2);
  }

  .bar-total-row td {
    border-bottom: 1px solid var(--ink);
  }

  .calc-note {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .calc-cta {
    margin-top: auto;
    width: 100%;
  }
</style>

<script define:vars={{ itemsData, eventsData, EVENT_SPLITS, BASE_DRINKS_PER_HOUR, BUFFER_PERCENTAGE, HOURLY_DECAY, DRINKING_PERCENTAGE }}>
  // Model constants come from src/data/model.ts and drink splits from
  // src/data/eventSplits.ts, both via define:vars, so this calculator, the
  // bar-setup pages, and the generator all read one source.

  function getTierFromGuestCount(guests) {
    if (guests <= 30) return 'small';
    if (guests <= 75) return 'medium';
    if (guests <= 150) return 'large';
    return 'xlarge';
  }

  // Valid guest counts that have pre-generated pages. The steppers move
  // through these; typing accepts any count from 10 to 300.
  const VALID_PAGE_GUESTS = [10, 15, 20, 25, 30, 40, 50, 75, 100, 125, 150, 200, 250, 300];

  function getNearestValidGuests(guests) {
    let closest = VALID_PAGE_GUESTS[0];
    let minDiff = Math.abs(guests - closest);
    for (const valid of VALID_PAGE_GUESTS) {
      const diff = Math.abs(guests - valid);
      if (diff < minDiff) {
        minDiff = diff;
        closest = valid;
      }
    }
    return closest;
  }

  // State: all four drinks are on by default, so the table shows the full
  // bar and the primary button goes straight to bar setup. Deselecting down
  // to one drink switches to that drink's own calculator page.
  let selectedItems = [...itemsData];
  let selectedEvent = eventsData[0];
  let selectedGuests = 100;
  let selectedDuration = eventsData[0].defaultDuration;

  // DOM
  const drinkToggles = document.querySelectorAll('.drink-toggle');
  const eventSelect = document.getElementById('event-select');
  const guestInput = document.getElementById('guest-input');
  const durationInput = document.getElementById('duration-input');
  const guestStepper = document.getElementById('guest-stepper');
  const durationStepper = document.getElementById('duration-stepper');
  const barRows = document.querySelectorAll('#bar-table tr[data-drink-id]');
  const barTotal = document.getElementById('bar-total');
  const calcContext = document.getElementById('calc-context');
  const calcNote = document.getElementById('calc-note');
  const detailLink = document.getElementById('detail-link');
  const ctaText = document.getElementById('cta-text');

  function calculateConsumptionMultiplier(durationHours) {
    let total = 0;
    for (let hour = 0; hour < durationHours; hour++) {
      const decayIndex = Math.min(hour, HOURLY_DECAY.length - 1);
      total += HOURLY_DECAY[decayIndex];
    }
    return total;
  }

  function calculateSingleDrink(item, guests, tier, duration, eventModifier) {
    const drinkingPct = DRINKING_PERCENTAGE[tier];
    const actualDrinkers = guests * drinkingPct;
    const consumptionMult = calculateConsumptionMultiplier(duration);
    const totalServings = Math.round(actualDrinkers * BASE_DRINKS_PER_HOUR * consumptionMult * eventModifier);
    const rawUnits = totalServings / item.servingsPerUnit;
    const unitsNeeded = Math.ceil(rawUnits * (1 + BUFFER_PERCENTAGE));
    return { totalServings, unitsNeeded };
  }

  // Total drinks are fixed by guests and duration. Selecting more drinks
  // divides that total rather than growing it, so there is no variety factor.
  // A single selection normalizes to a share of 1 and reduces to the
  // only-drink figure on its own.
  function calculate() {
    const guests = selectedGuests;
    const tier = getTierFromGuestCount(guests);
    const duration = selectedDuration;
    const splits = EVENT_SPLITS[selectedEvent.id] || EVENT_SPLITS.wedding;

    const totalSplit = selectedItems.reduce((sum, item) => sum + (splits[item.id] || 0.25), 0);

    let grandTotalServings = 0;
    const results = [];

    selectedItems.forEach(item => {
      const modifier = selectedEvent.modifiers[item.id] || 1.0;
      const singleCalc = calculateSingleDrink(item, guests, tier, duration, modifier);

      const normalizedSplit = (splits[item.id] || 0.25) / totalSplit;
      const servings = Math.round(singleCalc.totalServings * normalizedSplit);
      const unitsNeeded = Math.ceil((servings / item.servingsPerUnit) * (1 + BUFFER_PERCENTAGE));

      grandTotalServings += servings;
      results.push({ item, unitsNeeded, servings });
    });

    const perPerson = Math.round((grandTotalServings / guests) * 10) / 10;

    return { results, grandTotalServings, perPerson };
  }

  function updateResults() {
    const calc = calculate();

    barRows.forEach(row => {
      const drinkId = row.getAttribute('data-drink-id');
      const result = calc.results.find(r => r.item.id === drinkId);
      if (!result) {
        row.hidden = true;
        return;
      }
      row.hidden = false;
      const units = row.querySelector('.drink-units');
      const unitLabel = row.querySelector('.drink-unit-label');
      if (units) units.textContent = result.unitsNeeded;
      if (unitLabel) unitLabel.textContent = result.unitsNeeded === 1 ? result.item.unitSingular : result.item.unit;
    });

    if (barTotal) barTotal.textContent = calc.grandTotalServings;
    if (calcContext) calcContext.textContent = `${selectedGuests} guests · ${selectedDuration} hours`;
    if (calcNote) {
      calcNote.textContent = `About ${calc.perPerson} drinks per guest over the evening, heaviest in the first hour. Includes a 15 percent margin.`;
    }

    const pageGuests = getNearestValidGuests(selectedGuests);
    if (selectedItems.length === 1) {
      const slug = `${selectedItems[0].id}-for-${selectedEvent.slug}-${pageGuests}-guests`;
      detailLink.href = `/${slug}/?guests=${selectedGuests}&duration=${selectedDuration}`;
      ctaText.textContent = 'See the full breakdown and shopping list';
    } else {
      const drinks = selectedItems.map(i => i.id).join(',');
      detailLink.href = `/bar-setup/${selectedEvent.slug}-${pageGuests}-guests/?guests=${selectedGuests}&drinks=${drinks}&duration=${selectedDuration}`;
      ctaText.textContent = 'Plan the whole bar for this occasion';
    }
  }

  // Drink toggles
  drinkToggles.forEach(toggle => {
    toggle.addEventListener('click', () => {
      const itemId = toggle.dataset.item;
      const item = itemsData.find(i => i.id === itemId);
      const isSelected = selectedItems.some(i => i.id === itemId);

      // The last selected drink cannot be removed; a bar needs one drink.
      if (isSelected && selectedItems.length === 1) return;

      if (isSelected) {
        selectedItems = selectedItems.filter(i => i.id !== itemId);
      } else {
        selectedItems = itemsData.filter(
          i => selectedItems.some(s => s.id === i.id) || i.id === itemId,
        );
      }

      drinkToggles.forEach(btn => {
        btn.setAttribute('aria-pressed', String(selectedItems.some(i => i.id === btn.dataset.item)));
      });
      updateResults();
    });
  });

  // Occasion
  eventSelect.addEventListener('change', (e) => {
    selectedEvent = eventsData.find(ev => ev.id === e.target.value);
    selectedDuration = selectedEvent.defaultDuration;
    durationInput.value = selectedDuration;
    durationInput.setAttribute('aria-valuetext', `${selectedDuration} hours`);
    updateResults();
  });

  // Steppers: plus and minus move guests through the generated page counts and
  // hours by one; typing accepts anything inside the input's min and max.
  function clamp(value, min, max) {
    return Math.min(max, Math.max(min, value));
  }

  function setGuests(value) {
    selectedGuests = clamp(Math.round(value) || 10, 10, 300);
    guestInput.value = selectedGuests;
    guestInput.setAttribute('aria-valuetext', `${selectedGuests} guests`);
    updateResults();
  }

  function setDuration(value) {
    selectedDuration = clamp(Math.round(value) || 1, 1, 6);
    durationInput.value = selectedDuration;
    durationInput.setAttribute('aria-valuetext', `${selectedDuration} hours`);
    updateResults();
  }

  guestStepper.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-step]');
    if (!btn) return;
    const direction = btn.dataset.step === 'up' ? 1 : -1;
    const idx = VALID_PAGE_GUESTS.indexOf(getNearestValidGuests(selectedGuests));
    const next = VALID_PAGE_GUESTS[clamp(idx + direction, 0, VALID_PAGE_GUESTS.length - 1)];
    setGuests(next);
  });

  durationStepper.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-step]');
    if (!btn) return;
    setDuration(selectedDuration + (btn.dataset.step === 'up' ? 1 : -1));
  });

  guestInput.addEventListener('input', () => {
    const parsed = parseInt(guestInput.value, 10);
    if (!Number.isNaN(parsed)) {
      selectedGuests = clamp(parsed, 10, 300);
      guestInput.setAttribute('aria-valuetext', `${selectedGuests} guests`);
      updateResults();
    }
  });
  guestInput.addEventListener('change', () => setGuests(parseInt(guestInput.value, 10)));

  durationInput.addEventListener('input', () => {
    const parsed = parseInt(durationInput.value, 10);
    if (!Number.isNaN(parsed)) {
      selectedDuration = clamp(parsed, 1, 6);
      durationInput.setAttribute('aria-valuetext', `${selectedDuration} hours`);
      updateResults();
    }
  });
  durationInput.addEventListener('change', () => setDuration(parseInt(durationInput.value, 10)));

  // Initial render
  updateResults();
</script>
