---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import PageSection from '../../components/PageSection.astro';
import ProTips from '../../components/ProTips.astro';
import { seasonalEvents } from '../../data/seasonalEvents';
import { events } from '../../data/events';
import { items as drinkItems } from '../../data/items';
import { foodItems } from '../../data/foodItems';

const AMAZON_TAG = 'probuild20-20';

export function getStaticPaths() {
  return seasonalEvents.map((event) => ({
    params: { eventSlug: event.slug },
    props: { seasonalEvent: event },
  }));
}

interface Props {
  seasonalEvent: typeof seasonalEvents[0];
}

const { seasonalEvent } = Astro.props;

// The year is appended at build time rather than stored in the data, so the
// copy does not go stale on its own. A monthly rebuild keeps it current; see
// the monthly rebuild note in README.md.
const buildYear = new Date().getFullYear();

// Get the base event data
const baseEvent = events.find(e => e.id === seasonalEvent.eventType);

// Default guest count for initial calculations
const defaultGuestCount = 50;
const guestCountOptions = [25, 50, 75, 100, 150, 200];

// Get featured items data
const featuredDrinkItems = seasonalEvent.featuredDrinks
  .map(id => drinkItems.find(d => d.id === id))
  .filter(Boolean);

const featuredFoodItems = seasonalEvent.featuredFoods
  .map(id => foodItems.find(f => f.id === id))
  .filter(Boolean);

// Calculate example quantities for the default guest count (simplified)
// Uses servingsPerPersonSide since party pages show multiple foods together
function getExampleQuantity(itemId: string, type: 'drink' | 'food'): number {
  if (type === 'drink') {
    const item = drinkItems.find(d => d.id === itemId);
    if (!item || !baseEvent) return 0;
    const modifier = baseEvent.modifiers[itemId] || 1.0;
    const baseServings = defaultGuestCount * 0.75 * 1.5 * 3.75 * modifier;
    return Math.ceil((baseServings / item.servingsPerUnit) * 1.15);
  } else {
    const item = foodItems.find(f => f.id === itemId);
    if (!item || !baseEvent) return 0;
    const modifier = (baseEvent as any).foodModifiers?.[itemId] || 1.0;
    // Use servingsPerPersonSide since this is a spread with multiple foods
    const baseServings = defaultGuestCount * 0.9 * item.servingsPerPersonSide * modifier;
    return Math.ceil((baseServings / item.servingsPerOrderUnit) * 1.15);
  }
}

// Generate FAQ schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `How much food do I need for a ${defaultGuestCount} person ${seasonalEvent.shortName}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `For a ${defaultGuestCount}-person ${seasonalEvent.shortName}, plan for ${featuredFoodItems.map(f => f ? `${getExampleQuantity(f.id, 'food')} ${f.orderUnit} of ${f.name.toLowerCase()}` : '').filter(Boolean).join(', ')}.`
      }
    },
    {
      "@type": "Question",
      "name": `How much beer and drinks for a ${seasonalEvent.shortName}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `For a ${defaultGuestCount}-person ${seasonalEvent.shortName}, plan for ${featuredDrinkItems.map(d => d ? `${getExampleQuantity(d.id, 'drink')} ${d.unit} of ${d.name.toLowerCase()}` : '').filter(Boolean).join(', ')}.`
      }
    },
    {
      "@type": "Question",
      "name": `What food is best for a ${seasonalEvent.shortName}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The most popular foods for a ${seasonalEvent.shortName} are ${featuredFoodItems.map(f => f?.name.toLowerCase()).filter(Boolean).join(', ')}. These are crowd favorites that are easy to serve and enjoy.`
      }
    }
  ]
};
---

<BaseLayout
  title={`${seasonalEvent.metaTitle} ${buildYear}`}
  description={seasonalEvent.metaDescription}
  calculatorHref={baseEvent ? `/bar-setup/${baseEvent.slug}-${defaultGuestCount}-guests/` : undefined}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Hero -->
  <section class="container party-hero">
    <nav class="party-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/calculators/">Occasions</a>
      <span aria-hidden="true">/</span>
      <span>{seasonalEvent.shortName}</span>
    </nav>
    <h1 class="party-h1">{seasonalEvent.h1}</h1>
    <p class="party-deck">{seasonalEvent.subhead}</p>

    <div class="guest-select">
      <span class="label" id="guest-select-label">Guests</span>
      <div class="guest-btn-row" role="group" aria-labelledby="guest-select-label">
        {guestCountOptions.map((count) => (
          <button
            type="button"
            data-guest-count={count}
            class:list={['guest-btn num', count === defaultGuestCount && 'guest-btn-active']}
          >
            {count}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Quick answers -->
  <PageSection
    label="The spread"
    title="What you need"
    note="Food amounts assume a buffet spread with several dishes; drinks split one shared bar."
    ruleTone="ink"
    id="results"
  >
    <p class="party-for label">For <span id="selected-guests" class="num">{defaultGuestCount}</span> guests</p>

    <div class="party-tables">
      <div class="party-col">
        <span class="label party-col-head">Food</span>
        {featuredFoodItems.map((food) => food && (
          <a
            href={`/food/${food.id}-for-${baseEvent?.slug || 'party'}-${defaultGuestCount}-guests/`}
            class="food-card party-row"
            data-food-id={food.id}
          >
            <Icon name={food.icon} size={20} />
            <span class="party-row-name">{food.name}</span>
            <span
              class="num party-row-qty food-quantity"
              data-base-per-person={food.servingsPerPersonSide}
              data-servings-per-unit={food.servingsPerOrderUnit}
              data-modifier={(baseEvent as any).foodModifiers?.[food.id] || 1.0}
            >
              {getExampleQuantity(food.id, 'food')}
            </span>
            <span class="party-row-unit">{food.orderUnit}</span>
          </a>
        ))}
      </div>
      <div class="party-col">
        <span class="label party-col-head">Drinks</span>
        {featuredDrinkItems.map((drink) => drink && (
          <a
            href={`/${drink.id}-for-${baseEvent?.slug || 'party'}-${defaultGuestCount}-guests/`}
            class="drink-card party-row"
            data-drink-id={drink.id}
          >
            <Icon name={drink.icon} size={20} />
            <span class="party-row-name">{drink.name}</span>
            <span
              class="num party-row-qty drink-quantity"
              data-servings-per-unit={drink.servingsPerUnit}
              data-modifier={baseEvent?.modifiers[drink.id] || 1.0}
            >
              {getExampleQuantity(drink.id, 'drink')}
            </span>
            <span class="party-row-unit">{drink.unit}</span>
          </a>
        ))}
      </div>
    </div>
    <p class="party-note">Open any line for the full breakdown and shopping list.</p>
  </PageSection>

  <!-- All calculators -->
  <PageSection
    label="All calculators"
    title={`Every number for a ${seasonalEvent.shortName}`}
  >
    <div class="party-tables">
      <div class="party-col">
        <span class="label party-col-head">Food calculators</span>
        {foodItems.map((food) => (
          <a
            href={`/food/${food.id}-for-${baseEvent?.slug || 'party'}-${defaultGuestCount}-guests/`}
            class="complete-calc-link party-row"
            data-base-href={`/food/${food.id}-for-${baseEvent?.slug || 'party'}-${defaultGuestCount}-guests/`}
          >
            <Icon name={food.icon} size={20} />
            <span class="party-row-name">{food.name}</span>
            <Icon name="arrow" size={16} />
          </a>
        ))}
      </div>
      <div class="party-col">
        <span class="label party-col-head">Drink calculators</span>
        {drinkItems.map((drink) => (
          <a
            href={`/${drink.id}-for-${baseEvent?.slug || 'party'}-${defaultGuestCount}-guests/`}
            class="complete-calc-link party-row"
            data-base-href={`/${drink.id}-for-${baseEvent?.slug || 'party'}-${defaultGuestCount}-guests/`}
          >
            <Icon name={drink.icon} size={20} />
            <span class="party-row-name">{drink.name}</span>
            <Icon name="arrow" size={16} />
          </a>
        ))}
        {baseEvent && (
          <a
            href={`/bar-setup/${baseEvent.slug}-${defaultGuestCount}-guests/`}
            class="complete-calc-link party-row party-row-all"
            data-base-href={`/bar-setup/${baseEvent.slug}-${defaultGuestCount}-guests/`}
          >
            <span class="party-row-name">The whole bar together</span>
            <Icon name="arrow" size={16} />
          </a>
        )}
      </div>
    </div>
  </PageSection>

  <!-- Seasonal tips -->
  <ProTips title={`Notes for a ${seasonalEvent.shortName}`} tips={seasonalEvent.seasonalTips} />

  <!-- Essentials (affiliate) -->
  <PageSection
    label="Essentials"
    title="Gear worth having"
    note="Links open Amazon. As an Amazon Associate we earn from qualifying purchases."
  >
    <div class="party-supplies">
      {seasonalEvent.affiliateProducts.map((product) => (
        <a
          href={`https://www.amazon.com/s?k=${product.searchTerm}&tag=${AMAZON_TAG}`}
          target="_blank"
          rel="noopener sponsored"
          class="party-supply"
        >
          <span>{product.name}</span>
          <Icon name="external" size={16} />
        </a>
      ))}
    </div>
  </PageSection>

  <!-- Email capture -->
  <section class="container party-email-section">
    <div class="rule"></div>
    <div class="party-email">
      <EmailCapture
        eventType={seasonalEvent.eventType}
        eventName={seasonalEvent.shortName}
        placement="inline"
      />
    </div>
  </section>

  <!-- Other occasions -->
  <PageSection label="Other occasions" title="Planning a different party?">
    <div class="party-others">
      {seasonalEvents
        .filter(e => e.slug !== seasonalEvent.slug)
        .slice(0, 8)
        .map((event) => (
          <a href={`/party/${event.slug}/`} class="party-other-row">
            <span>{event.shortName}</span>
            <Icon name="arrow" size={16} />
          </a>
        ))}
    </div>
  </PageSection>
</BaseLayout>

<style>
  .party-hero {
    padding-top: 40px;
    padding-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .party-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 13px;
    color: var(--ink-2);
  }

  .party-crumbs a,
  .party-crumbs span {
    color: var(--ink-2);
  }

  .party-h1 {
    margin: 0;
    font-size: 34px;
    line-height: 1.1;
    text-wrap: balance;
    max-width: 24ch;
  }

  @media (min-width: 900px) {
    .party-h1 {
      font-size: 52px;
    }
  }

  .party-deck {
    margin: 0;
    font-size: 18px;
    color: var(--ink-2);
  }

  .guest-select {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 8px;
  }

  .guest-btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .guest-btn {
    min-width: 56px;
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink-2);
    font-weight: 600;
    font-size: 16px;
    cursor: pointer;
  }

  .guest-btn-active {
    border-color: var(--ink);
    background: var(--accent-soft);
    color: var(--ink);
  }

  .party-for {
    margin: 0 0 16px;
    color: var(--ink);
  }

  .party-tables {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
  }

  @media (min-width: 800px) {
    .party-tables {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .party-col {
    display: flex;
    flex-direction: column;
  }

  .party-col-head {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--ink);
  }

  .party-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-size: 16px;
  }

  .party-row-name {
    flex: 1;
  }

  .party-row-qty {
    font-size: 20px;
    font-weight: 600;
  }

  .party-row-unit {
    color: var(--ink-2);
    font-size: 14px;
    width: 64px;
  }

  .party-row-all {
    color: var(--accent);
    font-weight: 500;
  }

  .party-note {
    margin: 16px 0 0;
    font-size: 14px;
    color: var(--ink-2);
  }

  .party-supplies {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 32px;
  }

  @media (min-width: 700px) {
    .party-supplies {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .party-supply {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-size: 15px;
  }

  .party-email-section {
    padding-bottom: 56px;
  }

  .party-email {
    max-width: 560px;
    padding-top: 32px;
  }

  .party-others {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 32px;
  }

  @media (min-width: 700px) {
    .party-others {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .party-other-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-size: 16px;
  }
</style>

<script define:vars={{ defaultGuestCount, baseEventSlug: baseEvent?.slug || 'party' }}>
  // Guest count selector functionality
  document.querySelectorAll('.guest-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const count = parseInt(btn.dataset.guestCount);

      // Update UI
      document.querySelectorAll('.guest-btn').forEach(b => b.classList.remove('guest-btn-active'));
      btn.classList.add('guest-btn-active');

      // Update display
      document.getElementById('selected-guests').textContent = count.toString();

      // Update links and quantities with modifiers
      document.querySelectorAll('.food-card').forEach(card => {
        const foodId = card.dataset.foodId;
        const qtyEl = card.querySelector('.food-quantity');
        if (!qtyEl) return;
        const basePerPerson = parseFloat(qtyEl.dataset.basePerPerson || '3');
        const servingsPerUnit = parseFloat(qtyEl.dataset.servingsPerUnit || '8');
        const modifier = parseFloat(qtyEl.dataset.modifier || '1.0');
        const quantity = Math.ceil((count * 0.9 * basePerPerson * modifier / servingsPerUnit) * 1.15);
        qtyEl.textContent = quantity.toString();
        card.href = `/food/${foodId}-for-${baseEventSlug}-${count}-guests/`;
      });

      document.querySelectorAll('.drink-card').forEach(card => {
        const drinkId = card.dataset.drinkId;
        const qtyEl = card.querySelector('.drink-quantity');
        if (!qtyEl) return;
        const servingsPerUnit = parseFloat(qtyEl.dataset.servingsPerUnit || '24');
        const modifier = parseFloat(qtyEl.dataset.modifier || '1.0');
        const quantity = Math.ceil((count * 0.75 * 1.5 * 3.75 * modifier / servingsPerUnit) * 1.15);
        qtyEl.textContent = quantity.toString();
        card.href = `/${drinkId}-for-${baseEventSlug}-${count}-guests/`;
      });

      // Update the Complete Calculators grid links
      document.querySelectorAll('.complete-calc-link').forEach(link => {
        const baseHref = link.dataset.baseHref;
        if (baseHref) {
          link.href = baseHref.replace(`-${defaultGuestCount}-guests`, `-${count}-guests`);
        }
      });
    });
  });
</script>
