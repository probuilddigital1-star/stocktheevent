---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Unsubscribe | StockTheEvent"
  description="Unsubscribe from StockTheEvent emails."
>
  <section class="container unsub-page">
    <h1 class="unsub-h1">Unsubscribe</h1>
    <p class="unsub-note">Enter your email to unsubscribe from our mailing list.</p>

    <div id="unsubscribe-form" class="unsub-box">
      <form id="unsub-form" class="unsub-form">
        <label class="label" for="unsub-email">Email address</label>
        <div class="unsub-row">
          <input
            type="email"
            id="unsub-email"
            name="email"
            placeholder="you@example.com"
            required
            class="field"
          />
          <button type="submit" class="btn-primary">Unsubscribe</button>
        </div>
      </form>
      <p id="form-message" class="unsub-note hidden"></p>
    </div>

    <div id="success-message" class="hidden unsub-box">
      <h2 class="unsub-h2">You have been unsubscribed</h2>
      <p class="unsub-note">You will not receive any more emails from us.</p>
      <a href="/" class="btn-secondary unsub-back">Back to the calculator</a>
    </div>

    <p class="unsub-fine">
      Changed your mind? You can always sign up again on the <a href="/">homepage</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .unsub-page {
    max-width: 34rem;
    padding-top: 48px;
    padding-bottom: 64px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .unsub-h1 {
    margin: 0;
    font-size: 36px;
    line-height: 1.1;
  }

  .unsub-h2 {
    margin: 0;
    font-size: 24px;
  }

  .unsub-box {
    border: 1px solid var(--rule);
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .unsub-box.hidden {
    display: none;
  }

  .unsub-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .unsub-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .unsub-row .field {
    flex: 1;
    min-width: 200px;
  }

  .unsub-note {
    margin: 0;
    color: var(--ink-2);
  }

  .unsub-back {
    align-self: flex-start;
  }

  .unsub-fine {
    margin: 0;
    font-size: 14px;
    color: var(--ink-2);
  }
</style>

<script>
  const form = document.getElementById('unsub-form');
  const formContainer = document.getElementById('unsubscribe-form');
  const successMessage = document.getElementById('success-message');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form as HTMLFormElement);
    const email = formData.get('email');

    try {
      // Send unsubscribe request to n8n webhook
      await fetch('https://zax76.app.n8n.cloud/webhook/email-signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          action: 'unsubscribe',
          timestamp: new Date().toISOString()
        })
      });

      // Show success regardless (don't reveal if email exists)
      if (formContainer) formContainer.classList.add('hidden');
      if (successMessage) successMessage.classList.remove('hidden');

    } catch (err) {
      // Show success anyway for privacy (don't reveal if request failed)
      if (formContainer) formContainer.classList.add('hidden');
      if (successMessage) successMessage.classList.remove('hidden');
    }
  });
</script>
