---
import BaseLayout from '../layouts/BaseLayout.astro';
import InteractiveCalculator from '../components/InteractiveCalculator.astro';
import Icon from '../components/Icon.astro';
import { items } from '../data/items';
import { events } from '../data/events';
import { drinkShare, formatSharePercent } from '../data/eventSplits';
import { nextSeasonalEvent } from '../data/seasonalEvents';
import { AUTHOR } from '../data/site';

// Follows the build month; a monthly rebuild keeps the row current.
const featuredSeasonal = nextSeasonalEvent(new Date());

// One-line note per occasion, derived from the split data rather than written
// by hand: the leading drink (or the leading pair when the bar is balanced)
// and the default run time.
function occasionNote(event: (typeof events)[number]): string {
  const shares = items
    .map((item) => ({ item, share: drinkShare(event.id, item.id) }))
    .sort((a, b) => b.share - a.share);
  const [top, second] = shares;
  const lead =
    top.share >= second.share * 1.4
      ? `${top.item.name.toLowerCase()} forward`
      : `${top.item.name.toLowerCase()} and ${second.item.name.toLowerCase()}`;
  return `${lead} · ${event.defaultDuration} hours`;
}

// Rules of thumb rows, read from the data the calculator itself uses.
const rulesRows = items.map((item) => {
  const share = formatSharePercent(drinkShare('wedding', item.id));
  const shareNote =
    item.id === 'champagne'
      ? ', plus one flute each for the toast'
      : item.id === 'spirits'
        ? ', plus mixers and ice'
        : '';
  return {
    name: item.name,
    pour: item.standardPour ?? '',
    perUnit: `${item.servingsPerUnit} per ${item.unitSingular}`,
    share: `${share}%${shareNote}`,
  };
});
---

<BaseLayout
  title="Party Food & Drink Calculator | StockTheEvent"
  description="Calculate exactly how much food and drinks you need for your event. Quantities for weddings, birthdays, Super Bowl parties, and more, with the full method published. Wine, beer, pizza, wings & more."
  calculatorHref="#calculator"
>
  <!-- Hero + calculator -->
  <section class="container home-hero">
    <div class="hero-copy">
      <p class="label hero-kicker">Wine · Beer · Champagne · Spirits · Food</p>
      <h1 class="hero-h1">How much should you buy?</h1>
      <p class="hero-deck">
        Real quantities for any party, built on how people actually drink: about a
        drink and a half in the first hour, slowing after, split the way your
        occasion pours, with a 15 percent margin so you never run out.
      </p>
      <div class="hero-checks">
        <span><Icon name="check" size={20} /> Checked against The Knot and standard pours</span>
        <span><Icon name="check" size={20} /> Free, no signup</span>
      </div>
      <div class="hero-icons" aria-hidden="true">
        <Icon name="bottle" size={40} />
        <Icon name="case" size={104} />
        <Icon name="glass" size={56} />
        <Icon name="bottle" size={40} />
      </div>
    </div>
    <div class="hero-calc">
      <InteractiveCalculator />
    </div>
  </section>

  <!-- Rules of thumb -->
  <section class="container home-section">
    <div class="rule"></div>
    <div class="section-grid home-section-grid">
      <div class="section-head">
        <span class="label head-label">Rules of thumb</span>
        <h2 class="head-title">The numbers behind every answer</h2>
        <p class="head-note">
          Standard pours, standard packaging, a pace that slows as the night goes
          on, and a split that changes with the occasion. Nothing here is a
          secret; the calculator just does the arithmetic.
        </p>
      </div>
      <div class="section-body table-scroll">
        <table class="ledger">
          <thead>
            <tr>
              <th class="rules-drink-col">Drink</th>
              <th>Standard pour</th>
              <th>Servings per unit</th>
              <th class="rules-share-col">Share of a wedding bar</th>
            </tr>
          </thead>
          <tbody>
            {rulesRows.map((row) => (
              <tr>
                <td class="rules-name">{row.name}</td>
                <td class="rules-muted">{row.pour}</td>
                <td class="num">{row.perUnit}</td>
                <td class="num rules-share">{row.share}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- By occasion -->
  <section class="container home-section">
    <div class="rule"></div>
    <div class="section-grid home-section-grid">
      <div class="section-head">
        <span class="label head-label">By occasion</span>
        <h2 class="head-title">Weddings pour wine. Game day pours beer.</h2>
        <p class="head-note">
          Each occasion has its own split and its own pace. Pick yours to get the
          right mix.
        </p>
      </div>
      <div class="section-body occasion-index">
        <a href={`/party/${featuredSeasonal.slug}/`} class="occasion-row occasion-featured">
          <span>{featuredSeasonal.shortName}</span>
          <span class="occasion-note">This month</span>
        </a>
        {events.map((event) => (
          <a href={`/calculators/${event.id}/`} class="occasion-row">
            <span>{event.name}</span>
            <span class="occasion-note">{occasionNote(event)}</span>
          </a>
        ))}
        <a href="/calculators/" class="occasion-row occasion-all">
          <span>All {events.length} occasions</span>
          <Icon name="arrow" size={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- How the math works -->
  <section class="container home-section">
    <div class="rule"></div>
    <div class="section-grid home-section-grid">
      <div class="section-head">
        <span class="label head-label">How the math works</span>
        <h2 class="head-title">Every answer shows its work</h2>
      </div>
      <div class="method-copy">
        <p>
          Start with the guests who drink (70 to 80 percent, fewer at big
          events). Give each one about a drink and a half in the first hour, then
          slow the pace as the night goes on. Split the total across the drinks
          you serve the way that occasion tends to, convert to bottles and cases,
          and add 15 percent so the last hour is not a scramble.
        </p>
        <p>
          Every calculator page prints those steps with your numbers in them, so
          you can change any assumption you disagree with.
        </p>
        <a href="/methodology/" class="method-link">
          Read the full methodology <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="author-block">
        <span class="label">Formulas by</span>
        <span class="font-display author-name">{AUTHOR.name}</span>
        <span class="author-bio">{AUTHOR.role}. {AUTHOR.bio}</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    padding-top: 40px;
    padding-bottom: 56px;
    align-items: start;
  }

  @media (min-width: 1000px) {
    .home-hero {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 32px;
      padding-top: 72px;
      padding-bottom: 64px;
    }

    .hero-copy {
      grid-column: span 5;
      padding-right: 24px;
    }

    .hero-calc {
      grid-column: span 7;
    }
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .hero-kicker {
    color: var(--accent);
    margin: 0;
  }

  .hero-h1 {
    margin: 0;
    font-size: 40px;
    line-height: 1.04;
    text-wrap: balance;
  }

  @media (min-width: 900px) {
    .hero-h1 {
      font-size: 64px;
    }
  }

  .hero-deck {
    margin: 0;
    font-size: 19px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 34ch;
  }

  .hero-checks {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    color: var(--ink-2);
    font-size: 14px;
  }

  .hero-checks span {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .hero-icons {
    display: none;
    align-items: flex-end;
    gap: 28px;
    padding-top: 20px;
    color: var(--ink);
  }

  @media (min-width: 1000px) {
    .hero-icons {
      display: flex;
    }
  }

  .home-section {
    padding-bottom: 56px;
  }

  .home-section-grid {
    padding-top: 40px;
  }

  .section-head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .head-label {
    color: var(--accent);
  }

  .head-title {
    margin: 0;
    font-size: 28px;
    line-height: 1.15;
  }

  @media (min-width: 900px) {
    .head-title {
      font-size: 34px;
    }
  }

  .head-note {
    margin: 0;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.55;
    max-width: 32ch;
  }

  .rules-drink-col {
    width: 18%;
  }

  .rules-share-col,
  .rules-share {
    text-align: right;
  }

  .rules-name {
    font-weight: 500;
  }

  .rules-muted {
    color: var(--ink-2);
  }

  .occasion-index {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 48px;
  }

  @media (min-width: 700px) {
    .occasion-index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .occasion-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-size: 17px;
  }

  .occasion-note {
    font-size: 13px;
    color: var(--ink-2);
    text-align: right;
  }

  .occasion-featured .occasion-note {
    color: var(--accent);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 12px;
  }

  .occasion-all {
    color: var(--accent);
    font-weight: 500;
    align-items: center;
  }

  .method-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 17px;
    line-height: 1.6;
  }

  @media (min-width: 900px) {
    .method-copy {
      grid-column: span 5;
    }

    .author-block {
      grid-column: span 3;
    }
  }

  .method-copy p {
    margin: 0;
  }

  .method-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
  }

  .author-block {
    border-top: 1px solid var(--ink);
    padding-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .author-name {
    font-size: 20px;
  }

  .author-bio {
    font-size: 14px;
    color: var(--ink-2);
    line-height: 1.5;
  }
</style>
