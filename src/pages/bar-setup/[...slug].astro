---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import PageSection from '../../components/PageSection.astro';
import ProTips from '../../components/ProTips.astro';
import ThingsToHaveOnHand from '../../components/ThingsToHaveOnHand.astro';
import WhereToBuy from '../../components/WhereToBuy.astro';
import CrossPromo from '../../components/CrossPromo.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import AdSlot from '../../components/AdSlot.astro';
import { items } from '../../data/items';
import { events } from '../../data/events';
import { guestCounts } from '../../data/guestCounts';
import { isIndexable } from '../../data/indexing';
import { drinkShare, splitsForEvent, varietyNote, DRINK_VARIETIES } from '../../data/eventSplits';
import {
  BASE_DRINKS_PER_HOUR,
  BUFFER_PERCENTAGE,
  HOURLY_DECAY,
  DRINKING_PERCENTAGE,
  consumptionMultiplier as calculateConsumptionMultiplier,
} from '../../data/model';

// Generate static paths for all event/guest combinations
export function getStaticPaths() {
  const paths: { params: { slug: string }; props: { eventSlug: string; guestCount: number } }[] = [];

  for (const event of events) {
    for (const guest of guestCounts) {
      // Create the full slug: e.g., "graduation-party-100-guests"
      const slug = `${event.slug}-${guest.value}-guests`;
      paths.push({
        params: { slug },
        props: { eventSlug: event.slug, guestCount: guest.value }
      });
    }
  }

  return paths;
}

// Get props from getStaticPaths (avoids URL parsing issues)
const { eventSlug, guestCount } = Astro.props;

// Find event and guest data
const event = events.find(e => e.slug === eventSlug) || events[0];
const guestData = guestCounts.find(g => g.value === guestCount) || guestCounts[7];

// Default duration from event (can be overridden client-side)
const duration = event.defaultDuration;

// ALWAYS calculate for ALL 4 drinks at build time
// Client-side JS will filter based on query params
const allDrinks = items; // wine, beer, champagne, spirits

const drinkingPct = DRINKING_PERCENTAGE[guestData.tier];
const actualDrinkers = guestCount * drinkingPct;
const consumptionMult = calculateConsumptionMultiplier(duration);
const splits = splitsForEvent(event.id);

// Calculate for full bar (4 drinks) - this will be filtered client-side.
// Total drinks are fixed by guests and duration; the share only divides them,
// so there is no variety multiplier. Same order of operations as
// scripts/generateData.ts, which is what keeps the numbers on this page equal to
// the full bar number on each drink's own page.
const fullBarResults = allDrinks.map(item => {
  const modifier = event.modifiers[item.id] || 1.0;
  const totalServings = Math.round(actualDrinkers * BASE_DRINKS_PER_HOUR * consumptionMult * modifier);
  const baseUnits = Math.ceil((totalServings / item.servingsPerUnit) * (1 + BUFFER_PERCENTAGE));

  const share = drinkShare(event.id, item.id);
  const servings = Math.round(totalServings * share);
  const unitsNeeded = Math.ceil((servings / item.servingsPerUnit) * (1 + BUFFER_PERCENTAGE));

  return {
    item,
    unitsNeeded,
    servings,
    // A note rather than an inflated count where the bar is thinner than the
    // varieties worth stocking.
    note: varietyNote(item, unitsNeeded),
    // Also store single-drink calculation for client-side recalc
    singleDrinkUnits: baseUnits,
    singleDrinkServings: totalServings,
  };
});

const grandTotalServings = fullBarResults.reduce((sum, r) => sum + r.servings, 0);
const perPerson = Math.round((grandTotalServings / guestCount) * 10) / 10;

// Which drink this event actually leans on, taken from the split rather than
// guessed per event id.
const leadingDrink = fullBarResults.reduce((top, r) => (r.servings > top.servings ? r : top));

// Pass calculation data to client-side script
const clientData = {
  eventId: event.id,
  guestCount,
  duration,
  splits,
  drinkVarieties: DRINK_VARIETIES,
  eventModifiers: event.modifiers,
  results: fullBarResults.map(r => ({
    id: r.item.id,
    name: r.item.name,
    icon: r.item.icon,
    unit: r.item.unit,
    unitSingular: r.item.unitSingular,
    servingsPerUnit: r.item.servingsPerUnit,
    unitsNeeded: r.unitsNeeded,
    servings: r.servings,
    singleDrinkUnits: r.singleDrinkUnits,
    singleDrinkServings: r.singleDrinkServings,
  })),
};

// Glassware and gear for stocking the bar itself, resolved through the
// affiliate catalog for name, why, and pack math.
const thingsToHaveOnHandItems = [
  { key: 'wine-glasses' },
  { key: 'corkscrew' },
  { key: 'cooler' },
  { key: 'champagne-flutes' },
  { key: 'cocktail-shaker' },
  { key: 'bar-tools' },
  { key: 'ice-bucket' },
  { key: 'party-cups' },
];

// Generate JSON-LD schema for SEO/AIO
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `How much alcohol do I need for a ${guestCount} guest ${event.lowerName}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `For a ${guestCount}-guest ${event.lowerName}, you need ${fullBarResults.map(r => `${r.unitsNeeded} ${r.item.unit} of ${r.item.name.toLowerCase()}`).join(', ')}, about ${grandTotalServings} total servings (${perPerson} drinks per person) with a 15% buffer included.`
      }
    },
    {
      "@type": "Question",
      "name": `What is the drink breakdown for a ${event.lowerName} bar?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `A balanced bar for a ${event.lowerName} typically includes: ${fullBarResults.map(r => `${r.item.name} (${Math.round((r.servings / grandTotalServings) * 100)}%)`).join(', ')}. These proportions are adjusted based on event type. ${event.pluralName} tend to favor ${leadingDrink.item.name.toLowerCase()}.`
      }
    }
  ]
};
---

<BaseLayout
  title={`${event.name} Alcohol Calculator: ${guestCount} Guests (Wine, Beer, Spirits, Champagne)`}
  description={`A full bar for ${guestCount} guests at a ${event.lowerName} is about ${grandTotalServings} servings, ${perPerson} drinks per person. Wine, beer, spirits and champagne quantities with a 15 percent buffer included.`}
  ogImage={isIndexable(guestCount) ? `/og/${event.slug}-${guestCount}-guests.png` : undefined}
  ogImageAlt={`${event.name} full bar for ${guestCount} guests`}
>
  <!-- JSON-LD Schema for SEO/AIO -->
  <Fragment slot="head">
    {!isIndexable(guestCount) && (
      <meta name="robots" content="noindex, follow" />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <section class="container bar-header">
    <div class="bar-grid">
      <div class="bar-main">
        <nav class="bar-crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/bar-setup/">Full bar</a>
          <span aria-hidden="true">/</span>
          <span>{event.name}</span>
        </nav>

        <!--
          The H1 is the page's own heading and stays put. The selection label
          below it is what the client script rewrites when ?drinks= narrows the
          list, so changing the selection no longer overwrites the heading.
        -->
        <h1 class="bar-h1">{event.name} Alcohol Calculator: {guestCount} Guests</h1>
        <p class="bar-context">
          <span id="page-title" class="label bar-subtitle">Your Complete Bar</span>
          <span class="num bar-meta"><span id="guest-display">{guestCount}</span> guests · <span id="duration-display">{duration}</span> hours</span>
        </p>
      </div>
    </div>

    <div class="bar-table-wrap" id="drink-grid">
      <table class="bar-table">
          {fullBarResults.map((r) => (
            <tbody
              class="drink-card"
              data-drink-id={r.item.id}
              data-units={r.unitsNeeded}
              data-servings={r.servings}
              data-single-units={r.singleDrinkUnits}
              data-single-servings={r.singleDrinkServings}
            >
              <tr>
                <td class="bar-icon"><Icon name={r.item.icon} size={20} /></td>
                <td class="bar-name">{r.item.name}</td>
                <td class="num bar-units">
                  <span class="bar-value drink-units">{r.unitsNeeded}</span><span class="bar-unit">{r.item.unit}</span>
                </td>
                <td class="num bar-servings drink-servings">{r.servings} servings</td>
              </tr>
              <tr class="bar-note-row" style={r.note ? undefined : 'display: none'}>
                <td></td>
                <td colspan="4" class="drink-note bar-note">{r.note}</td>
              </tr>
              {r.item.id === 'spirits' && (
                <tr class="cross-promo-row">
                  <td></td>
                  <td colspan="4"><CrossPromo /></td>
                </tr>
              )}
            </tbody>
          ))}
      </table>
      <p class="num bar-total-line">
        <span id="total-servings" class="bar-total-strong">{grandTotalServings}</span> servings, about <span id="per-person">{perPerson}</span> drinks per person
      </p>
      <p class="bar-buffer-note">15% buffer included on each category.</p>

      <WhereToBuy itemIds={fullBarResults.map((r) => r.item.id)} />
      <AffiliateDisclosure />
    </div>
  </section>

  <AdSlot id="bar-setup-after-results" />

  <PageSection label="Shopping list" title="What to put in the cart">
    <div class="shop-list" id="shopping-list">
      {fullBarResults.map((r) => (
        <div class="shopping-item shop-row" data-drink-id={r.item.id}>
          <span class="num shop-qty"><span class="item-units">{r.unitsNeeded}</span><span class="shop-unit">{r.item.unit}</span></span>
          <span class="shop-name">{r.item.name}</span>
        </div>
      ))}
      <div class="shop-actions">
        <button id="copy-list" type="button" class="btn-secondary shop-btn">
          <Icon name="copy" size={18} /> Copy shopping list
        </button>
      </div>

      <ThingsToHaveOnHand items={thingsToHaveOnHandItems} />
    </div>
    <div class="bar-email">
      <EmailCapture eventType={event.id} placement="inline" />
    </div>
  </PageSection>

  <PageSection
    label="More detail"
    title="Each drink, shown with its work"
    note="Every drink page prints the arithmetic and a printable list."
  >
    <div class="detail-links" id="detail-links">
      {fullBarResults.map((r) => (
        <a
          href={`/${r.item.id}-for-${event.slug}-${guestCount}-guests/`}
          class="detail-link"
          data-drink-id={r.item.id}
          data-units={r.unitsNeeded}
          data-servings={r.servings}
        >
          <Icon name={r.item.icon} size={20} />
          <span class="detail-name">{r.item.name}</span>
          <span class="num detail-units">{r.unitsNeeded} {r.item.unit}</span>
          <Icon name="arrow" size={18} />
        </a>
      ))}
    </div>
  </PageSection>

  <ProTips
    title={`Planning notes for a ${event.lowerName}`}
    tips={event.proTips.slice(0, 3)}
    guide={event.buyingGuide}
  />
</BaseLayout>

<style>
  .bar-header {
    padding-top: 40px;
    padding-bottom: 56px;
  }

  .bar-main {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .bar-crumbs {
    display: flex;
    gap: 10px;
    font-size: 13px;
    color: var(--ink-2);
  }

  .bar-crumbs a,
  .bar-crumbs span {
    color: var(--ink-2);
  }

  .bar-h1 {
    margin: 0;
    font-size: 34px;
    line-height: 1.1;
    text-wrap: balance;
  }

  @media (min-width: 900px) {
    .bar-h1 {
      font-size: 48px;
    }
  }

  .bar-context {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }

  .bar-subtitle {
    color: var(--ink);
  }

  .bar-meta {
    font-size: 14px;
    color: var(--ink-2);
  }

  .bar-table-wrap {
    max-width: 720px;
    margin-top: 28px;
  }

  .bar-table {
    border-collapse: collapse;
    width: 100%;
  }

  .bar-table td {
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: middle;
  }

  .bar-icon {
    width: 32px;
    color: var(--ink);
  }

  .bar-units {
    text-align: right;
  }

  .bar-value {
    font-size: 22px;
    font-weight: 600;
  }

  .bar-unit {
    margin-left: 0.35em;
    font-size: 16px;
    font-weight: 400;
    color: var(--ink-2);
  }

  .bar-servings {
    text-align: right;
    color: var(--ink-2);
    font-size: 14px;
  }

  .bar-note-row td {
    border-bottom: 1px solid var(--rule);
    padding-top: 0;
  }

  .bar-note {
    font-size: 13px;
    color: var(--ink-2);
  }

  .cross-promo-row td {
    border-bottom: none;
    padding: 0;
  }

  .bar-total-line {
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--ink);
    font-size: 16px;
    color: var(--ink-2);
  }

  .bar-total-strong {
    font-weight: 600;
    color: var(--ink);
  }

  .bar-buffer-note {
    margin: 6px 0 0;
    font-size: 13px;
    color: var(--ink-2);
  }

  .shop-list {
    display: flex;
    flex-direction: column;
    max-width: 560px;
  }

  .shop-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }

  .shop-row:first-child {
    border-top: 1px solid var(--ink);
  }

  .shop-row:last-of-type {
    border-bottom: 1px solid var(--ink);
  }

  .shop-qty {
    font-weight: 600;
    width: 110px;
    flex-shrink: 0;
  }

  .shop-unit {
    margin-left: 0.35em;
    font-weight: 400;
    color: var(--ink-2);
  }

  .shop-actions {
    padding-top: 16px;
  }

  .shop-btn {
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
  }

  .bar-email {
    margin-top: 24px;
    max-width: 560px;
  }

  .detail-links {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
  }

  @media (min-width: 700px) {
    .detail-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .detail-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--rule);
    color: var(--ink);
    min-height: 44px;
  }

  .detail-link:hover {
    border-color: var(--ink);
    background: var(--accent-soft);
    text-decoration: none;
  }

  .detail-name {
    flex: 1;
  }

  .detail-units {
    font-weight: 600;
  }

</style>

<script define:vars={{ clientData, BASE_DRINKS_PER_HOUR, BUFFER_PERCENTAGE, HOURLY_DECAY, DRINKING_PERCENTAGE }}>
  // Model constants arrive from src/data/model.ts via define:vars rather than
  // being redeclared here, so this recalculation cannot drift from the generator.

  function getTier(guests) {
    if (guests <= 30) return 'small';
    if (guests <= 75) return 'medium';
    if (guests <= 150) return 'large';
    return 'xlarge';
  }

  function calculateConsumption(durationHours) {
    let total = 0;
    for (let hour = 0; hour < durationHours; hour++) {
      const decayIndex = Math.min(hour, HOURLY_DECAY.length - 1);
      total += HOURLY_DECAY[decayIndex];
    }
    return total;
  }

  // Client-side: Parse actual query params from browser URL
  const urlParams = new URLSearchParams(window.location.search);
  const drinksParam = urlParams.get('drinks');
  const durationParam = urlParams.get('duration');
  const guestsParam = urlParams.get('guests');

  // Get actual guest count (from query param or pre-rendered)
  const actualGuests = guestsParam ? parseInt(guestsParam) : clientData.guestCount;
  const actualDuration = durationParam ? parseInt(durationParam) : clientData.duration;

  // Default to all drinks if no param specified (direct navigation)
  const selectedDrinkIds = drinksParam
    ? drinksParam.split(',').filter(Boolean)
    : ['wine', 'beer', 'champagne', 'spirits'];

  const drinkCount = selectedDrinkIds.length;

  // If custom guest count, we need to recalculate base values
  const needsRecalc = actualGuests !== clientData.guestCount || actualDuration !== clientData.duration;

  // Recalculate single-drink base values if needed
  let recalcResults = {};
  if (needsRecalc) {
    const tier = getTier(actualGuests);
    const drinkingPct = DRINKING_PERCENTAGE[tier];
    const actualDrinkers = actualGuests * drinkingPct;
    const consumptionMult = calculateConsumption(actualDuration);

    clientData.results.forEach(r => {
      const modifier = clientData.eventModifiers[r.id] || 1.0;
      const totalServings = Math.round(actualDrinkers * BASE_DRINKS_PER_HOUR * consumptionMult * modifier);
      const rawUnits = totalServings / r.servingsPerUnit;
      const unitsNeeded = Math.ceil(rawUnits * (1 + BUFFER_PERCENTAGE));
      recalcResults[r.id] = { singleUnits: unitsNeeded, singleServings: totalServings };
    });
  }

  // Update displayed guest count
  if (actualGuests !== clientData.guestCount) {
    const guestDisplayEl = document.getElementById('guest-display');
    if (guestDisplayEl) guestDisplayEl.textContent = actualGuests.toString();
  }

  // Update page title based on selection
  const pageTitle = document.getElementById('page-title');
  if (pageTitle) {
    pageTitle.textContent = drinkCount === 4 ? 'Your Complete Bar' : 'Your Bar Setup';
  }

  // Update duration if provided
  if (durationParam) {
    const durationDisplayEl = document.getElementById('duration-display');
    if (durationDisplayEl) durationDisplayEl.textContent = String(parseInt(durationParam));
  }

  // Hide drink rows that weren't selected
  const drinkCards = document.querySelectorAll('.drink-card');
  const shoppingItems = document.querySelectorAll('.shopping-item');
  const detailLinks = document.querySelectorAll('.detail-link');

  drinkCards.forEach(card => {
    const drinkId = card.getAttribute('data-drink-id');
    if (!selectedDrinkIds.includes(drinkId)) {
      card.style.display = 'none';
    }
  });

  shoppingItems.forEach(item => {
    const drinkId = item.getAttribute('data-drink-id');
    if (!selectedDrinkIds.includes(drinkId)) {
      item.style.display = 'none';
    }
  });

  detailLinks.forEach(link => {
    const drinkId = link.getAttribute('data-drink-id');
    if (!selectedDrinkIds.includes(drinkId)) {
      link.style.display = 'none';
    }
  });

  // Recalculate totals based on visible drinks.
  // No variety factor: total drinks are fixed by guests and duration, and the
  // selection only divides them.
  const splits = clientData.splits;

  function formatList(values) {
    if (values.length <= 1) return values[0] || '';
    if (values.length === 2) return `${values[0]} and ${values[1]}`;
    return `${values.slice(0, -1).join(', ')}, and ${values[values.length - 1]}`;
  }

  function varietyNoteFor(drinkId, units) {
    const info = clientData.results.find(r => r.id === drinkId);
    const varieties = clientData.drinkVarieties[drinkId] || [];
    if (!info || varieties.length === 0 || units >= varieties.length) return null;
    return `For a proper ${info.name.toLowerCase()} selection, that is at least one ${info.unitSingular} each of ${formatList(varieties)}.`;
  }

  // Calculate total split for selected drinks only
  const totalSplit = selectedDrinkIds.reduce((sum, id) => sum + (splits[id] || 0.25), 0);

  let newTotalServings = 0;

  // Recalculate each visible drink
  drinkCards.forEach(card => {
    const drinkId = card.getAttribute('data-drink-id');
    if (!selectedDrinkIds.includes(drinkId)) return;

    // Use recalculated base values if guest count changed, otherwise use pre-rendered
    let singleUnits, singleServings;
    if (needsRecalc && recalcResults[drinkId]) {
      singleUnits = recalcResults[drinkId].singleUnits;
      singleServings = recalcResults[drinkId].singleServings;
    } else {
      singleUnits = parseInt(card.getAttribute('data-single-units') || '0');
      singleServings = parseInt(card.getAttribute('data-single-servings') || '0');
    }

    // One drink selected normalizes to a share of 1, which reduces to the
    // only-drink figure, so there is no special case for it.
    const itemInfo = clientData.results.find(r => r.id === drinkId);
    const servingsPerUnit = itemInfo ? itemInfo.servingsPerUnit : 1;
    const normalizedSplit = (splits[drinkId] || 0.25) / totalSplit;
    const newServings = Math.round(singleServings * normalizedSplit);
    const newUnits = Math.ceil((newServings / servingsPerUnit) * (1 + BUFFER_PERCENTAGE));

    // Update row display
    const unitsEl = card.querySelector('.drink-units');
    const servingsEl = card.querySelector('.drink-servings');
    if (unitsEl) unitsEl.textContent = newUnits.toString();
    if (servingsEl) servingsEl.textContent = `${newServings} servings`;

    // Show or hide the variety note for this drink
    const noteEl = card.querySelector('.drink-note');
    if (noteEl) {
      const note = varietyNoteFor(drinkId, newUnits);
      noteEl.textContent = note || '';
      const noteRow = noteEl.closest('.bar-note-row');
      if (noteRow) noteRow.style.display = note ? '' : 'none';
    }

    // Update shopping list
    const shoppingItem = document.querySelector(`.shopping-item[data-drink-id="${drinkId}"]`);
    if (shoppingItem) {
      const itemUnits = shoppingItem.querySelector('.item-units');
      if (itemUnits) itemUnits.textContent = newUnits.toString();
    }

    // Update detail link with new values
    const detailLink = document.querySelector(`.detail-link[data-drink-id="${drinkId}"]`);
    if (detailLink) {
      // Update the displayed units
      const detailUnits = detailLink.querySelector('.detail-units');
      const itemData = clientData.results.find(r => r.id === drinkId);
      if (detailUnits && itemData) {
        detailUnits.textContent = `${newUnits} ${itemData.unit}`;
      }
      // Carry adjusted guests and duration through to the drink page, which
      // reads them and recalculates on load.
      const currentHref = detailLink.getAttribute('href') || '';
      const baseHref = currentHref.split('?')[0];
      const linkParams = new URLSearchParams();
      if (needsRecalc) linkParams.set('guests', String(actualGuests));
      if (actualDuration !== clientData.duration) linkParams.set('duration', String(actualDuration));
      const query = linkParams.toString();
      detailLink.setAttribute('href', `${baseHref}${query ? `?${query}` : ''}`);
    }

    newTotalServings += newServings;
  });

  // Update all totals
  const perPerson = Math.round((newTotalServings / actualGuests) * 10) / 10;

  const totalServingsEl = document.getElementById('total-servings');
  const perPersonEl = document.getElementById('per-person');

  if (totalServingsEl) totalServingsEl.textContent = newTotalServings.toString();
  if (perPersonEl) perPersonEl.textContent = perPerson.toString();

  // Copy shopping list functionality
  const copyBtn = document.getElementById('copy-list');
  copyBtn?.addEventListener('click', () => {
    const visibleItems = [];
    document.querySelectorAll('.shopping-item').forEach(item => {
      if (item.style.display !== 'none') {
        const name = item.querySelector('.shop-name')?.textContent?.trim();
        const units = item.querySelector('.item-units')?.textContent?.trim();
        const unit = item.querySelector('.shop-unit')?.textContent?.trim();
        if (name && units) {
          visibleItems.push(`${units} ${unit} of ${name}`);
        }
      }
    });

    const listText = visibleItems.join('\n');
    const fullText = `Shopping List:\n${listText}\n\nGenerated by StockTheEvent.com`;

    navigator.clipboard.writeText(fullText).then(() => {
      copyBtn.textContent = 'Copied';
      setTimeout(() => {
        copyBtn.textContent = 'Copy shopping list';
      }, 2000);
    });
  });
</script>
