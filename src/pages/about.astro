---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR } from '../data/site';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about/' }
];

// A real person, described only by what this site demonstrates. The previous
// schema named a fictional "StockTheEvent Team" and claimed a hospitality
// credential that does not exist.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": AUTHOR.name,
  "jobTitle": AUTHOR.role,
  "description": AUTHOR.bio,
  "url": "https://www.stocktheevent.com/about/",
  ...(AUTHOR.links.length > 0 ? { sameAs: AUTHOR.links } : {}),
  "worksFor": {
    "@type": "Organization",
    "name": "StockTheEvent",
    "url": "https://www.stocktheevent.com"
  }
};
---

<BaseLayout
  title="About StockTheEvent - Drink Calculator"
  description="Who publishes StockTheEvent and how the drink calculations work. Never run out, or over-buy, for your event again."
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </Fragment>

  <section class="container prose-page">
    <nav class="prose-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span>About</span>
    </nav>

    <h1 class="prose-h1">About Stock the Event</h1>
    <p class="prose-lede">Party quantity calculators with the whole method published.</p>

    <h2 class="prose-h2">The problem</h2>
    <p>
      Every event planner faces the same dilemma: buy too little alcohol and run
      out mid-party, or buy too much and waste money on bottles that never get
      opened.
    </p>
    <p>
      Most online calculators give you a generic "1 drink per person per hour"
      formula. That might work for a corporate mixer, but it is wildly off for a
      Super Bowl party or a wedding reception.
    </p>

    <h2 class="prose-h2">Our solution</h2>
    <p>StockTheEvent uses a published formula you can check line by line. It factors in:</p>
    <ol class="prose-list">
      <li><strong>Event type modifiers.</strong> Weddings drink 20% more wine; Super Bowl parties drink 40% more beer.</li>
      <li><strong>Consumption decay.</strong> People drink faster in the first hour and slow down as the event progresses.</li>
      <li><strong>Guest count scaling.</strong> Larger events have a lower percentage of active drinkers.</li>
      <li><strong>A safety buffer.</strong> We add 15% so you never run out.</li>
    </ol>

    <h2 class="prose-h2">The formula</h2>
    <div class="num prose-formula">
      <p>Base: 1.5 drinks per person per hour</p>
      <p>Adjusted for: consumption decay curve</p>
      <p>Modified by: event type</p>
      <p>Scaled by: guest count tier</p>
      <p>Buffer: +15% safety margin</p>
    </div>
    <p>
      Every constant in that formula is published, with worked examples and two
      outside comparisons, on the <a href="/methodology/">methodology page</a>.
    </p>

    <h2 class="prose-h2">Our mission</h2>
    <p>
      We believe everyone deserves to throw a great party without the stress of
      running out of drinks or wasting money on over-buying.
    </p>

    <div class="prose-author">
      <h2 class="prose-h2">Who runs this site</h2>
      <p class="prose-author-name">{AUTHOR.name}</p>
      <p class="prose-author-role">{AUTHOR.role}</p>
      <p>{AUTHOR.bio}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .prose-page {
    max-width: 44rem;
    padding-top: 40px;
    padding-bottom: 64px;
  }

  .prose-crumbs {
    display: flex;
    gap: 10px;
    font-size: 13px;
    color: var(--ink-2);
    margin-bottom: 24px;
  }

  .prose-crumbs a,
  .prose-crumbs span {
    color: var(--ink-2);
  }

  .prose-h1 {
    margin: 0 0 12px;
    font-size: 36px;
    line-height: 1.1;
  }

  @media (min-width: 900px) {
    .prose-h1 {
      font-size: 48px;
    }
  }

  .prose-lede {
    margin: 0 0 8px;
    font-size: 18px;
    color: var(--ink-2);
  }

  .prose-h2 {
    margin: 36px 0 12px;
    font-size: 24px;
    line-height: 1.2;
  }

  .prose-page p {
    line-height: 1.7;
    margin: 0 0 14px;
  }

  .prose-list {
    padding-left: 1.25rem;
    margin: 0 0 14px;
  }

  .prose-list li {
    margin-bottom: 8px;
    line-height: 1.6;
  }

  .prose-formula {
    border: 1px solid var(--rule);
    padding: 16px 20px;
    margin: 0 0 16px;
    color: var(--ink-2);
  }

  .prose-formula p {
    margin: 0 0 4px;
  }

  .prose-author {
    margin-top: 40px;
    border-top: 1px solid var(--ink);
    padding-top: 8px;
  }

  .prose-author-name {
    font-weight: 600;
    margin-bottom: 2px !important;
  }

  .prose-author-role {
    color: var(--ink-2);
    font-size: 14px;
  }
</style>
