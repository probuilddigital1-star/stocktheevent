---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { foodItems } from '../../data/foodItems';
import { events } from '../../data/events';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Food Calculators', url: '/food/' },
];
---

<BaseLayout
  title="Food Calculators | StockTheEvent"
  description="Free food calculators for any event. Calculate exactly how much pizza, wings, tacos, sliders, appetizers, or BBQ you need for weddings, parties, and more."
  breadcrumbs={breadcrumbs}
>
  <section class="container index-hero">
    <nav class="index-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span>Food</span>
    </nav>
    <h1 class="index-h1">How much food for a party?</h1>
    <p class="index-deck">
      Pick a dish for its numbers across every event and guest count. Each
      figure assumes that dish is the main food; the pages show what changes
      when it shares the table.
    </p>
  </section>

  <section class="container index-section">
    <div class="rule"></div>
    <div class="section-grid index-grid">
      <div class="section-head">
        <span class="label index-label">By food</span>
        <h2 class="index-title">Six dishes, sized to your guest list</h2>
      </div>
      <div class="section-body food-index">
        {foodItems.map((food) => (
          <a href={`/food/${food.id}/`} class="food-row">
            <Icon name={food.icon} size={22} />
            <span class="food-row-name">{food.name}</span>
            <span class="num food-row-note">{food.servingsPerOrderUnit} servings per {food.orderUnitSingular}</span>
            <Icon name="arrow" size={18} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="container index-section">
    <div class="rule"></div>
    <div class="section-grid index-grid">
      <div class="section-head">
        <span class="label index-label">By occasion</span>
        <h2 class="index-title">Food and drinks together</h2>
        <p class="index-note">
          Each occasion page carries both tables, food and the full bar.
        </p>
      </div>
      <div class="section-body occasion-index">
        {events.map((event) => (
          <a href={`/calculators/${event.id}/`} class="occasion-row">
            <span>{event.name}</span>
            <span class="occasion-note">{event.foodTips[0]?.split(/[,.]/)[0].toLowerCase()}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="container index-section">
    <div class="rule"></div>
    <p class="index-method">
      Every number here comes from the same model, explained in full on the
      <a href="/methodology/">methodology page</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .index-hero {
    padding-top: 40px;
    padding-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .index-crumbs {
    display: flex;
    gap: 10px;
    font-size: 13px;
    color: var(--ink-2);
  }

  .index-crumbs a,
  .index-crumbs span {
    color: var(--ink-2);
  }

  .index-h1 {
    margin: 0;
    font-size: 36px;
    line-height: 1.06;
  }

  @media (min-width: 900px) {
    .index-h1 {
      font-size: 56px;
    }
  }

  .index-deck {
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 48ch;
  }

  .index-section {
    padding-bottom: 56px;
  }

  .index-grid {
    padding-top: 32px;
  }

  .index-label {
    color: var(--accent);
  }

  .index-title {
    margin: 0;
    font-size: 26px;
    line-height: 1.15;
  }

  @media (min-width: 900px) {
    .index-title {
      font-size: 32px;
    }
  }

  .index-note {
    margin: 0;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.55;
    max-width: 30ch;
  }

  .food-index {
    display: flex;
    flex-direction: column;
  }

  .food-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-size: 17px;
  }

  .food-row-name {
    flex: 1;
  }

  .food-row-note {
    font-size: 13px;
    color: var(--ink-2);
  }

  .occasion-index {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 48px;
  }

  @media (min-width: 700px) {
    .occasion-index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .occasion-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-size: 17px;
  }

  .occasion-note {
    font-size: 13px;
    color: var(--ink-2);
    text-align: right;
    max-width: 24ch;
  }

  .index-method {
    margin: 32px 0 0;
    font-size: 14px;
    color: var(--ink-2);
  }
</style>
