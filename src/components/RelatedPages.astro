---
/**
 * RelatedPages.astro - the "Nearby" section: three text-index columns of
 * other calculator pages, grouped by how they relate to this one.
 */
import PageSection from './PageSection.astro';
import type { RelatedPage } from '../lib/types';

interface Props {
  pages: RelatedPage[];
  currentEvent: string;
  currentItem: string;
  /** Path prefix for the links, "/" for drinks and "/food/" for foods. */
  basePath?: string;
}

const { pages, currentEvent, currentItem, basePath = '/' } = Astro.props;

const columns = [
  { label: `Same ${currentEvent.toLowerCase()}`, pages: pages.filter(p => p.relationship === 'same-event') },
  { label: 'Different size', pages: pages.filter(p => p.relationship === 'adjacent-guests') },
  { label: `${currentItem} elsewhere`, pages: pages.filter(p => p.relationship === 'same-item') },
].filter(col => col.pages.length > 0);
---

{columns.length > 0 && (
  <PageSection label="Nearby" title="Other numbers you may need">
    <div class="nearby-grid">
      {columns.map((col) => (
        <div class="nearby-col">
          <span class="label nearby-head">{col.label}</span>
          {col.pages.map((page) => (
            <a href={`${basePath}${page.slug}/`} class="nearby-link">{page.title}</a>
          ))}
        </div>
      ))}
    </div>
  </PageSection>
)}

<style>
  .nearby-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px 32px;
  }

  @media (min-width: 700px) {
    .nearby-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0 32px;
    }
  }

  .nearby-col {
    display: flex;
    flex-direction: column;
  }

  .nearby-head {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--ink);
  }

  .nearby-link {
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-size: 15px;
  }
</style>
