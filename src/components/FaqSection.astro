---
/**
 * FaqSection.astro - renders the questions that are also emitted as FAQPage
 * JSON-LD, so readers see the same answers search engines do. Answers are
 * fully visible: question in the display face, a rule between rows.
 *
 * Callers build the question list once and pass it here and to the schema,
 * which keeps the two from drifting.
 */
import PageSection from './PageSection.astro';

export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  heading: string;
  items: FaqItem[];
}

const { heading, items } = Astro.props;
---

{items.length > 0 && (
  <PageSection label="Questions" title={heading}>
    <div class="faq-list">
      {items.map((item) => (
        <div class="faq-item">
          <h3 class="font-display faq-question">{item.question}</h3>
          <p class="num faq-answer">{item.answer}</p>
        </div>
      ))}
    </div>
  </PageSection>
)}

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .faq-item:first-child {
    padding-top: 0;
  }

  .faq-question {
    margin: 0;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.3;
  }

  .faq-answer {
    margin: 0;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.55;
    max-width: 62ch;
  }
</style>
