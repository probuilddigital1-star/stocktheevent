---
import * as fs from 'fs';
import * as path from 'path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnswerHeader from '../../components/AnswerHeader.astro';
import AdjustBox from '../../components/AdjustBox.astro';
import HowWeGotThere from '../../components/HowWeGotThere.astro';
import QuickReference from '../../components/QuickReference.astro';
import type { QuickReferenceRow } from '../../components/QuickReference.astro';
import ShoppingChecklist from '../../components/ShoppingChecklist.astro';
import ProTips from '../../components/ProTips.astro';
import FaqSection from '../../components/FaqSection.astro';
import type { FaqItem } from '../../components/FaqSection.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import Icon from '../../components/Icon.astro';
import { foodItems } from '../../data/foodItems';
import { items as drinkItems } from '../../data/items';
import type { FoodCalculatorPage } from '../../lib/types';
import { isIndexable } from '../../data/indexing';
import { BUFFER_PERCENTAGE, EATING_PERCENTAGE } from '../../data/model';

const QUICK_REFERENCE_GUEST_COUNTS = [25, 50, 75, 100, 150, 200];
const FOOD_CALCULATORS_DIR = path.join(process.cwd(), 'src/content/food-calculators');

/**
 * Reads a sibling food page's own generated data, so a quick-reference row
 * shows exactly what its linked page shows rather than a scaled estimate.
 * Returns null if that page was never generated.
 */
function readSiblingFoodPage(itemId: string, eventSlug: string, guests: number): FoodCalculatorPage | null {
  const filePath = path.join(FOOD_CALCULATORS_DIR, `${itemId}-for-${eventSlug}-${guests}-guests.json`);
  if (!fs.existsSync(filePath)) return null;
  return JSON.parse(fs.readFileSync(filePath, 'utf-8'));
}

export async function getStaticPaths() {
  // Read all food calculator JSON files directly
  const foodDir = path.join(process.cwd(), 'src/content/food-calculators');

  // Check if directory exists
  if (!fs.existsSync(foodDir)) {
    return [];
  }

  const files = fs.readdirSync(foodDir).filter(f => f.endsWith('.json') && !f.startsWith('_'));

  return files.map((file) => {
    const dataPath = path.join(foodDir, file);
    const pageData: FoodCalculatorPage = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
    const slug = file.replace('.json', '');

    return {
      params: { slug },
      props: { page: pageData },
    };
  });
}

interface Props {
  page: FoodCalculatorPage;
}

const { page } = Astro.props;

const food = page.item.name.toLowerCase();
const eventName = page.event.lowerName;
const calc = page.calculation;

const contextLine = `as the main dish · ${calc.totalServings} servings · about ${calc.perPersonServings} per guest`;
const unitLine = `${calc.unitsDisplay} of ${food}`;

// The shared-table figure: what this dish needs when it is one of several on
// the table, from the same model the generator uses for side servings.
const foodModifier = (page.event as any).foodModifiers?.[page.item.id] ?? 1.0;
const eatingPct = EATING_PERCENTAGE[page.guestCount.tier];
const sideServings = Math.round(page.guestCount.value * eatingPct * page.item.servingsPerPersonSide * foodModifier);
const sideUnits = Math.ceil((sideServings / page.item.servingsPerOrderUnit) * (1 + BUFFER_PERCENTAGE));
const sideDisplay = sideUnits === 1 ? page.item.orderUnitSingular : page.item.orderUnit;

// Quick-reference rows read each sibling page's own generated numbers rather
// than scaling this page's numbers by a guest ratio: the eating rate varies by
// guest tier, so a scaled row can disagree with the page it links to. A guest
// count with no generated page is skipped rather than estimated.
const quickReferenceRows: QuickReferenceRow[] = QUICK_REFERENCE_GUEST_COUNTS
  .map((guests) => {
    const sibling = readSiblingFoodPage(page.item.id, page.event.slug, guests);
    if (!sibling) return null;
    const isCurrent = guests === page.guestCount.value;
    return {
      guests,
      href: isCurrent ? null : `/food/${page.item.id}-for-${page.event.slug}-${guests}-guests/`,
      values: [
        `${sibling.calculation.unitsNeeded} ${sibling.calculation.unitsDisplay}`,
        `${sibling.calculation.totalServings}`,
      ],
      isCurrent,
    };
  })
  .filter((row): row is QuickReferenceRow => row !== null);

// The other foods at this event, for the Adjust box.
const otherFoods = foodItems
  .filter((item) => item.id !== page.item.id)
  .map((item) => ({
    href: `/food/${item.id}-for-${page.event.slug}-${page.guestCount.value}-guests/`,
    label: item.name,
    icon: item.icon,
  }));

const barSetupHref = `/bar-setup/${page.event.slug}-${page.guestCount.value}-guests/`;

// How each shopping row's quantity derives from the calculation, matched to
// scripts/generateFoodData.ts, so the client script can update quantities live.
const SHOPPING_ROW_CALCS: Record<string, string[]> = {
  pizza: ['main', 'guests*1.5', 'guests*3', 'static', 'static'],
  wings: ['main', 'units/3', 'guests/4', 'guests*2', 'units/10'],
  tacos: ['main', 'guests/8', 'guests/10', 'guests/2', 'guests/15'],
  sliders: ['main', 'units*1', 'units*1', 'guests/10', 'static'],
  appetizers: ['main', 'units/30', 'guests*4', 'static', 'guests*1.5'],
  bbq: ['main', 'units*3', 'units/3', 'guests/4', 'guests/15'],
};
const rowCalcs = SHOPPING_ROW_CALCS[page.item.id] ?? [];

// Get the event food tips if available
const eventFoodTips = (page.event as any).foodTips || [];
const eventFoodBuyingGuide = (page.event as any).foodBuyingGuide || '';

// Related drink links for this event, with the drink icons.
const DRINK_ICONS: Record<string, string> = { wine: 'wine', beer: 'beer', champagne: 'flute', spirits: 'spirit' };

// Breadcrumbs for structured data
// Item 3 points at the per-food hub.
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Food Calculators', url: '/food/' },
  { name: page.item.name, url: `/food/${page.item.id}/` },
  { name: `${page.guestCount.value} Guests`, url: `/food/${page.slug}/` }
];

const crumbs = [
  { label: 'Food', href: '/food/' },
  { label: page.item.name, href: `/food/${page.item.id}/` },
  { label: page.event.name, href: `/calculators/${page.event.id}/` },
];

// HowTo Schema - optimized for AIO
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": `Calculate ${page.item.name} for ${page.guestCount.value} Guests`,
  "description": page.meta.description,
  "step": page.mathExplanation.map((step, i) => ({
    "@type": "HowToStep",
    "position": i + 1,
    "name": step.label,
    "text": `${step.formula} = ${step.result}. ${step.explanation}`,
  })),
  "totalTime": "PT30S",
  "tool": [{ "@type": "HowToTool", "name": "StockTheEvent Food Calculator" }],
  "supply": [{ "@type": "HowToSupply", "name": `${calc.unitsNeeded} ${calc.unitsDisplay} of ${food}` }]
};

// FAQ built once, then fed to both the visible section and the JSON-LD so the
// two cannot drift apart.
const faqItems: FaqItem[] = [
  {
    question: `How much ${food} do I need for ${page.guestCount.value} guests?`,
    answer: `You need ${calc.unitsNeeded} ${calc.unitsDisplay} of ${food} for ${page.guestCount.value} guests at a ${eventName}. This provides ${calc.totalServings} total servings with a 15% buffer.`,
  },
  {
    question: `How much ${food} per person for a ${eventName}?`,
    answer: `Plan for ${calc.perPersonServings} servings of ${food} per person at a ${eventName}. This assumes ${food} is your main food; reduce by 30-40% if serving multiple dishes.`,
  },
  {
    question: `How many servings in ${calc.unitsNeeded} ${calc.unitsDisplay} of ${food}?`,
    answer: `${calc.unitsNeeded} ${calc.unitsDisplay} of ${food} provides ${calc.totalServings} total servings, enough for ${page.guestCount.value} guests with a 15% buffer to ensure you don't run out.`,
  },
  {
    question: `Is ${calc.unitsNeeded} ${calc.unitsDisplay} of ${food} enough for ${page.guestCount.value} people?`,
    answer: `Yes, ${calc.unitsNeeded} ${calc.unitsDisplay} is the recommended amount for ${page.guestCount.value} guests at a ${eventName}. This includes a 15% buffer (${calc.buffer} extra ${calc.unitsDisplay}) so you won't run short.`,
  },
  {
    question: `Should I order more ${food} than calculated?`,
    answer: `Our calculation of ${calc.unitsNeeded} ${calc.unitsDisplay} already includes a 15% buffer. However, if your guests are big eaters or ${food} is the only food, consider adding 10-20% more. It's always better to have leftovers!`,
  },
  {
    question: `What if I'm serving ${food} with other foods?`,
    answer: `If serving ${food} as part of a buffet spread with other options, reduce this amount by 30-40%. Instead of ${calc.unitsNeeded} ${calc.unitsDisplay}, you'd need approximately ${Math.ceil(calc.unitsNeeded * 0.65)} ${calc.unitsDisplay}.`,
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};

// ItemList Schema for shopping list
const shoppingListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Shopping List: ${page.item.name} for ${page.guestCount.value} Guest ${page.event.name}`,
  "numberOfItems": page.shoppingList.length,
  "itemListElement": page.shoppingList.map((item, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": `${item.quantity} ${item.unit} ${item.name}`,
    "description": item.notes || undefined
  }))
};
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  breadcrumbs={breadcrumbs}
  calculatorHref={barSetupHref}
>
  <!-- JSON-LD Schema -->
  <Fragment slot="head">
    {!isIndexable(page.guestCount.value) && (
      <meta name="robots" content="noindex, follow" />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(shoppingListSchema)} />
  </Fragment>

  <AnswerHeader
    crumbs={crumbs}
    h1={page.meta.h1}
    units={calc.unitsNeeded}
    unitLine={unitLine}
    contextLine={contextLine}
    onlyDrink={{
      lead: `If ${food} shares the table with other dishes`,
      figure: `${sideUnits} ${sideDisplay}`,
      perGuest: `(${page.item.servingsPerPersonSide} per guest instead of ${page.item.servingsPerPerson})`,
    }}
  >
    <AdjustBox
      slot="aside"
      guests={page.guestCount.value}
      hours={null}
      othersLabel={`Also at this ${eventName}`}
      others={otherFoods}
      primaryHref={barSetupHref}
      primaryLabel={`Plan the whole bar for this ${eventName}`}
    />
  </AnswerHeader>

  <HowWeGotThere
    title={`${['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight'][page.mathExplanation.length] ?? page.mathExplanation.length} lines of arithmetic`}
    note="Change any assumption you disagree with; the answer follows."
    steps={page.mathExplanation}
  >
    <p class="method-line num">
      Every constant behind this figure is published, including the eating rate
      by guest count and the 15 percent buffer;
      <a href="/methodology/">read the methodology</a>.
    </p>
  </HowWeGotThere>

  <QuickReference
    title={`${page.item.name} for a ${eventName}, by guest count`}
    columns={[page.item.name, 'Servings']}
    rows={quickReferenceRows}
    footnote={`Figures assume ${food} is the main dish; serving several dishes together lowers each one.`}
  />

  <ShoppingChecklist
    items={page.shoppingList}
    rowCalcs={rowCalcs}
    buyLabel={`${calc.unitsNeeded} ${calc.unitsDisplay}`}
  />

  {eventFoodTips.length > 0 && (
    <ProTips
      title={`Food at a ${eventName}`}
      tips={eventFoodTips.slice(0, 5)}
      guide={eventFoodBuyingGuide}
    />
  )}

  <FaqSection
    heading={`${page.item.name} at a ${eventName}`}
    items={faqItems}
  />

  {page.relatedDrinks && page.relatedDrinks.length > 0 && (
    <section class="container drink-links-section">
      <div class="rule"></div>
      <div class="section-grid drink-links-grid">
        <div class="section-head">
          <span class="label drink-links-label">The bar</span>
          <h2 class="drink-links-title">Drinks for this {eventName}</h2>
        </div>
        <div class="section-body drink-links-list">
          {page.relatedDrinks.map((drink) => {
            const drinkId = drink.slug.split('-')[0];
            return (
              <a href={`/${drink.slug}/`} class="drink-link">
                <Icon name={DRINK_ICONS[drinkId] || 'glass'} size={20} />
                <span>{drink.title}</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <RelatedPages
    pages={page.relatedPages}
    currentEvent={page.event.name}
    currentItem={page.item.name}
    basePath="/food/"
  />
</BaseLayout>

<style>
  .method-line {
    margin: 14px 0 0;
    font-size: 14px;
    color: var(--ink-2);
    max-width: 62ch;
  }

  .drink-links-section {
    padding-bottom: 56px;
  }

  .drink-links-grid {
    padding-top: 32px;
  }

  .drink-links-label {
    color: var(--accent);
  }

  .drink-links-title {
    margin: 0;
    font-size: 26px;
    line-height: 1.15;
  }

  @media (min-width: 900px) {
    .drink-links-title {
      font-size: 32px;
    }
  }

  .drink-links-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    align-content: start;
  }

  @media (min-width: 700px) {
    .drink-links-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .drink-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border: 1px solid var(--rule);
    color: var(--ink);
    font-size: 15px;
    min-height: 44px;
  }

  .drink-link:hover {
    border-color: var(--ink);
    background: var(--accent-soft);
    text-decoration: none;
  }
</style>

<script define:vars={{
  guestCount: page.guestCount.value,
  itemData: {
    id: page.item.id,
    name: page.item.name,
    servingsPerPerson: page.item.servingsPerPerson,
    servingsPerPersonSide: page.item.servingsPerPersonSide,
    servingsPerOrderUnit: page.item.servingsPerOrderUnit,
    orderUnit: page.item.orderUnit,
    orderUnitSingular: page.item.orderUnitSingular,
    unitType: page.item.unitType,
    unit: page.item.unit,
  },
  foodModifier,
  BUFFER_PERCENTAGE,
  EATING_PERCENTAGE
}}>
  // Mirrors scripts/generateFoodData.ts. The guest stepper rewrites the
  // answer, the math ledger, the quick-reference highlight and the shopping
  // list, and mirrors the state into the URL with replaceState. Run time does
  // not change food quantities, so there is no hour stepper here.

  const foodName = itemData.name.toLowerCase();
  const unitWord = itemData.unitType === 'weight' ? 'pieces' : itemData.unit;

  function getTier(guests) {
    if (guests <= 30) return 'small';
    if (guests <= 75) return 'medium';
    if (guests <= 150) return 'large';
    return 'xlarge';
  }

  function recalculate(guests) {
    const tier = getTier(guests);
    const eatingPct = EATING_PERCENTAGE[tier];
    const eaters = Math.round(guests * eatingPct);

    const totalServings = Math.round(guests * eatingPct * itemData.servingsPerPerson * foodModifier);
    const rawExact = totalServings / itemData.servingsPerOrderUnit;
    const unitsNeeded = Math.ceil(rawExact * (1 + BUFFER_PERCENTAGE));
    const rawUnits = Math.round(rawExact * 10) / 10;

    const sideServings = Math.round(guests * eatingPct * itemData.servingsPerPersonSide * foodModifier);
    const sideUnits = Math.ceil((sideServings / itemData.servingsPerOrderUnit) * (1 + BUFFER_PERCENTAGE));

    return {
      tier, eatingPct, eaters, totalServings, rawUnits, unitsNeeded, sideUnits,
      perPerson: Math.round((totalServings / guests) * 10) / 10,
    };
  }

  function unitsDisplay(units) {
    return units === 1 ? itemData.orderUnitSingular : itemData.orderUnit;
  }

  // A null formula leaves the build-time formula in place.
  function setMathStep(step, formula, result) {
    const row = document.querySelector(`[data-math-step="${step}"]`);
    if (!row) return;
    const formulaEl = row.querySelector('.math-formula');
    const resultEl = row.querySelector('.math-result');
    if (formulaEl && formula !== null) formulaEl.textContent = formula;
    if (resultEl) resultEl.textContent = result;
  }

  function updateMathLedger(calc, guests) {
    const pctLabel = Math.round(calc.eatingPct * 100);
    setMathStep(1, `${guests} guests × ${pctLabel}% eating rate`, `${calc.eaters} eaters`);
    setMathStep(2,
      `${calc.eaters} eaters × ${itemData.servingsPerPerson} ${unitWord} per person`,
      `${Math.round(calc.eaters * itemData.servingsPerPerson)} base servings`);
    setMathStep(3, null, `${calc.totalServings} ${unitWord} needed`);
    setMathStep(4,
      `${calc.totalServings} ${unitWord} ÷ ${itemData.servingsPerOrderUnit} per ${itemData.orderUnitSingular}`,
      `${calc.rawUnits} ${itemData.orderUnit} (raw)`);
    setMathStep(5,
      `${calc.rawUnits} × 1.15 = ${(calc.rawUnits * 1.15).toFixed(1)}, rounded up`,
      `${calc.unitsNeeded} ${unitsDisplay(calc.unitsNeeded)}`);
  }

  function updateQuickReference(guests) {
    const rows = document.querySelectorAll('#quick-reference tbody tr[data-guests]');
    if (!rows.length) return;
    let nearest = null;
    let minDiff = Infinity;
    rows.forEach(row => {
      const value = parseInt(row.getAttribute('data-guests') || '0', 10);
      const diff = Math.abs(value - guests);
      if (diff < minDiff) {
        minDiff = diff;
        nearest = row;
      }
    });
    rows.forEach(row => row.classList.toggle('qr-current', row === nearest));
  }

  function updateShoppingList(calc, guests) {
    document.querySelectorAll('#shopping-list .shop-row').forEach(row => {
      const q = row.getAttribute('data-q');
      const qtyEl = row.querySelector('.shop-qty');
      if (!q || q === 'static' || !qtyEl) return;
      if (q === 'main') {
        qtyEl.textContent = `${calc.unitsNeeded} ${unitsDisplay(calc.unitsNeeded)}`;
        return;
      }
      const match = q.match(/^(guests|units|servings)([*/])([\d.]+)$/);
      if (!match) return;
      const base = match[1] === 'guests' ? guests
        : match[1] === 'units' ? calc.unitsNeeded
        : calc.totalServings;
      const factor = parseFloat(match[3]);
      const value = Math.ceil(match[2] === '*' ? base * factor : base / factor);
      const unitText = row.getAttribute('data-unit') || '';
      qtyEl.textContent = `${value} ${unitText}`;
    });

    const buyLabel = document.getElementById('where-to-buy-label');
    if (buyLabel) buyLabel.textContent = `Where to buy ${calc.unitsNeeded} ${unitsDisplay(calc.unitsNeeded)}`;
  }

  let currentGuests = guestCount;
  let displayedGuests = guestCount;

  function applyState(guests, updateUrl) {
    currentGuests = guests;
    const calc = recalculate(guests);

    const answerNumber = document.querySelector('.answer-number');
    if (answerNumber) answerNumber.textContent = calc.unitsNeeded;
    const answerUnit = document.querySelector('.answer-unit');
    if (answerUnit) answerUnit.textContent = `${unitsDisplay(calc.unitsNeeded)} of ${foodName}`;
    const answerContext = document.querySelector('.answer-context');
    if (answerContext) {
      answerContext.textContent = `as the main dish · ${calc.totalServings} servings · about ${calc.perPerson} per guest`;
    }

    const sideFigure = document.querySelector('.answer-only-drink .only-drink-figure');
    if (sideFigure) sideFigure.textContent = `${calc.sideUnits} ${calc.sideUnits === 1 ? itemData.orderUnitSingular : itemData.orderUnit}`;

    const h1 = document.querySelector('h1');
    if (h1 && h1.textContent.includes(String(displayedGuests))) {
      h1.textContent = h1.textContent.replace(String(displayedGuests), String(guests));
    }
    displayedGuests = guests;

    updateMathLedger(calc, guests);
    updateQuickReference(guests);
    updateShoppingList(calc, guests);

    if (updateUrl) {
      const params = new URLSearchParams(window.location.search);
      if (guests !== guestCount) params.set('guests', String(guests));
      else params.delete('guests');
      const query = params.toString();
      history.replaceState(null, '', `${window.location.pathname}${query ? `?${query}` : ''}`);
    }
  }

  const guestInput = document.getElementById('adjust-guests');
  const guestStepper = document.getElementById('adjust-guests-stepper');
  const GUEST_STEPS = [10, 15, 20, 25, 30, 40, 50, 75, 100, 125, 150, 200, 250, 300];

  function clamp(value, min, max) {
    return Math.min(max, Math.max(min, value));
  }

  function nearestStepIndex(guests) {
    let best = 0;
    let minDiff = Infinity;
    GUEST_STEPS.forEach((value, i) => {
      const diff = Math.abs(value - guests);
      if (diff < minDiff) {
        minDiff = diff;
        best = i;
      }
    });
    return best;
  }

  function setGuests(value, updateUrl = true) {
    const guests = clamp(Math.round(value) || 10, 10, 300);
    if (guestInput) {
      guestInput.value = guests;
      guestInput.setAttribute('aria-valuetext', `${guests} guests`);
    }
    applyState(guests, updateUrl);
  }

  guestStepper?.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-step]');
    if (!btn) return;
    const direction = btn.dataset.step === 'up' ? 1 : -1;
    const idx = nearestStepIndex(currentGuests);
    setGuests(GUEST_STEPS[clamp(idx + direction, 0, GUEST_STEPS.length - 1)]);
  });

  guestInput?.addEventListener('change', () => setGuests(parseInt(guestInput.value, 10)));

  // Apply URL parameters on load
  const urlParams = new URLSearchParams(window.location.search);
  const customGuests = parseInt(urlParams.get('guests') || '', 10);
  if (!Number.isNaN(customGuests) && customGuests !== guestCount) {
    setGuests(customGuests, false);
  }
</script>
