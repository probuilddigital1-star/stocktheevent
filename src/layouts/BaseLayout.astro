---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { nextSeasonalEvent } from '../data/seasonalEvents';
import { withTrailingSlash } from '../lib/canonical';

// The featured seasonal event follows the build month rather than being pinned
// to one page year-round. A monthly rebuild keeps it current. It is linked by
// its own name (footer and homepage); the Occasions nav link goes to the index.
const featuredSeasonal = nextSeasonalEvent(new Date());

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  breadcrumbs?: BreadcrumbItem[];
  /**
   * Where the header "Try the calculator" link points. The homepage passes
   * "#calculator" to scroll to its own calculator; calculator pages pass the
   * bar-setup page for their event.
   */
  calculatorHref?: string;
}

const {
  title,
  description,
  ogImage = '/og-default.png',
  ogImageAlt = 'StockTheEvent party quantity calculators',
  breadcrumbs,
  calculatorHref = '/#calculator',
} = Astro.props;
const siteUrl = 'https://www.stocktheevent.com';

const resolvedCanonical = withTrailingSlash(new URL(Astro.url.pathname, Astro.site));

// Organization Schema (sitewide)
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "StockTheEvent",
  "url": siteUrl,
  "logo": `${siteUrl}/logo.png`,
  "description": "Free food and drink calculators for party planning. Published quantities for weddings, birthdays, Super Bowl parties, and more, with the full calculation model shown.",
  "foundingDate": "2024",
  "sameAs": [],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "url": `${siteUrl}/about/`
  }
};

// WebSite Schema (for sitelinks search box)
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "StockTheEvent",
  "url": siteUrl,
  "description": "Free party food and drink calculators"
};

// BreadcrumbList Schema (if breadcrumbs provided)
// The last item always represents the current page, so its URL is the derived canonical.
const breadcrumbSchema = breadcrumbs ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((item, index) => {
    const isLast = index === breadcrumbs.length - 1;
    const url = isLast
      ? resolvedCanonical
      : (item.url.startsWith('http') ? item.url : `${siteUrl}${item.url}`);
    return {
      "@type": "ListItem",
      "position": index + 1,
      "name": item.name,
      "item": url
    };
  })
} : null;

const navLinks = [
  { href: '/calculators/', label: 'Drinks' },
  { href: '/food/', label: 'Food' },
  { href: '/bar-setup/', label: 'Full bar' },
  { href: '/calculators/', label: 'Occasions' },
  { href: '/methodology/', label: 'How the math works' },
  { href: '/about/', label: 'About' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="StockTheEvent" />
    <meta name="theme-color" content="#F5F6F3" />

    <!-- FlexOffers affiliate network site verification -->
    <meta name="fo-verify" content="f8a0a762-68b5-4170-b423-e51663570769" />

    <title>{title}</title>

    <link rel="canonical" href={resolvedCanonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={resolvedCanonical} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Self-hosted fonts: preload the two faces used above the fold -->
    <link rel="preload" href="/fonts/libre-caslon-text-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Turnstile: only loaded once a site key exists (PUBLIC_TURNSTILE_SITE_KEY unset -> no script, no widget). -->
    {import.meta.env.PUBLIC_TURNSTILE_SITE_KEY && (
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
    )}

    <!-- Slot for page-specific head content (schema, etc) -->
    <slot name="head" />

    <!-- Sitewide Schema.org structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
  </head>
  <body class="min-h-screen">
    <!-- Skip Navigation -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Header -->
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <span class="brand-name font-display">Stock the Event</span>
          <span class="label brand-tag">Party quantity calculators</span>
        </a>

        <nav class="site-nav" aria-label="Main">
          {navLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
          <a href={calculatorHref}>Try the calculator</a>
        </nav>

        <button
          id="mobile-menu-btn"
          class="menu-btn"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span id="menu-icon"><Icon name="menu" size={24} /></span>
          <span id="close-icon" class="hidden"><Icon name="close" size={24} /></span>
        </button>
      </div>

      <!-- Mobile Menu -->
      <div id="mobile-menu" class="mobile-menu hidden">
        <nav aria-label="Mobile">
          {navLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
          <a href={calculatorHref}>Try the calculator</a>
        </nav>
      </div>
    </header>

    <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const menuIcon = document.getElementById('menu-icon');
      const closeIcon = document.getElementById('close-icon');

      menuBtn?.addEventListener('click', () => {
        const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
        menuBtn.setAttribute('aria-expanded', String(!isExpanded));
        menuBtn.setAttribute('aria-label', isExpanded ? 'Open navigation menu' : 'Close navigation menu');
        mobileMenu?.classList.toggle('hidden');
        menuIcon?.classList.toggle('hidden');
        closeIcon?.classList.toggle('hidden');
      });
    </script>

    <!-- Main Content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <span class="font-display footer-wordmark">Stock the Event</span>
          <span>Party quantity calculators. Drink responsibly. 21+.</span>
          <span>As an Amazon Associate we earn from qualifying purchases.</span>
        </div>
        <div class="footer-col">
          <span class="label">Drinks</span>
          <a href="/calculators/wine/">Wine</a>
          <a href="/calculators/beer/">Beer</a>
          <a href="/calculators/champagne/">Champagne</a>
          <a href="/calculators/spirits/">Spirits</a>
        </div>
        <div class="footer-col">
          <span class="label">Food</span>
          <a href="/food/pizza/">Pizza</a>
          <a href="/food/wings/">Wings</a>
          <a href="/food/tacos/">Tacos</a>
          <a href="/food/bbq/">BBQ</a>
        </div>
        <div class="footer-col">
          <span class="label">Site</span>
          <a href="/methodology/">Methodology</a>
          <a href="/bar-setup/">Full bar</a>
          <a href={`/party/${featuredSeasonal.slug}/`}>{featuredSeasonal.shortName}</a>
          <a href="/embed-calculator/">Embed the calculator</a>
          <a href="/about/">About</a>
        </div>
        <div class="footer-col">
          <span class="label">Legal</span>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
        </div>
      </div>
    </footer>

    <ConsentBanner />

    <script>
      import { track } from '../lib/track';
      import { isRegulatedRegion, getConsent } from '../lib/consent';
      import { loadAdSenseScript } from '../lib/ads';
      import { initAnalytics } from '../lib/analytics';

      // Mirrored onto window: Astro's define:vars scripts (InteractiveCalculator,
      // [slug].astro, food/[slug].astro, ShoppingChecklist.astro) can't use
      // `import`, so they call window.track?.(...) instead.
      window.track = track;

      const AD_NETWORK = import.meta.env.PUBLIC_AD_NETWORK || 'none';
      const ADSENSE_CLIENT = import.meta.env.PUBLIC_ADSENSE_CLIENT;

      const regulated = isRegulatedRegion();
      const consent = getConsent();
      // Cookieless until a visitor in a regulated region explicitly accepts;
      // outside the EU/UK, PostHog runs with its normal persistence.
      // initAnalytics makes this same computation internally for PostHog's
      // own persistence; it is kept here too since ad loading has its own
      // separate gate.
      const needsConsentGate = regulated && consent !== 'accepted';

      initAnalytics();

      if (AD_NETWORK === 'adsense' && ADSENSE_CLIENT && !needsConsentGate) {
        loadAdSenseScript(ADSENSE_CLIENT);
      }

      // Delegated click tracking: any affiliate link anywhere on the page,
      // identified by data-affiliate or a sponsored rel, with no per-link
      // listener to wire up.
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest('a');
        if (!link) return;
        const key = link.getAttribute('data-affiliate');
        const rel = link.getAttribute('rel') || '';
        if (!key && !rel.includes('sponsored')) return;
        let retailer = null;
        try {
          retailer = new URL(link.href).hostname;
        } catch {
          retailer = null;
        }
        track('affiliate_click', {
          key: key || null,
          retailer,
          page: window.location.pathname,
        });
      });
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--accent);
    color: var(--paper);
    padding: 10px 16px;
    font-weight: 600;
  }

  .skip-link:focus {
    left: 16px;
    top: 16px;
  }

  .site-header {
    border-bottom: 1px solid var(--ink);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 14px;
    color: var(--ink);
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand-name {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .brand-tag {
    white-space: nowrap;
  }

  .site-nav {
    display: none;
    align-items: center;
    gap: 28px;
    font-size: 15px;
    font-weight: 500;
  }

  .site-nav a {
    color: var(--ink);
  }

  .menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 0;
    color: var(--ink);
    cursor: pointer;
  }

  .mobile-menu {
    border-top: 1px solid var(--rule);
  }

  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    padding: 8px 24px 16px;
  }

  .mobile-menu a {
    color: var(--ink);
    font-size: 16px;
    font-weight: 500;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }

  .mobile-menu a:last-child {
    border-bottom: 0;
  }

  @media (max-width: 899px) {
    .brand-tag {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .site-nav {
      display: flex;
    }

    .menu-btn,
    .mobile-menu {
      display: none;
    }
  }

  .site-footer {
    border-top: 1px solid var(--ink);
    margin-top: 64px;
    padding: 32px 0 40px;
    font-size: 14px;
    color: var(--ink-2);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  @media (min-width: 900px) {
    .footer-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: span 4;
    }

    .footer-col {
      grid-column: span 2;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  @media (max-width: 899px) {
    .footer-brand {
      grid-column: span 2;
    }
  }

  .footer-wordmark {
    font-size: 20px;
    color: var(--ink);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-col a {
    color: var(--ink);
  }
</style>
