---
import * as fs from 'fs';
import * as path from 'path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import DrinkSwitcher from '../components/DrinkSwitcher.astro';
import AnswerHero from '../components/AnswerHero.astro';
import MathBreakdown from '../components/MathBreakdown.astro';
import ShoppingList from '../components/ShoppingList.astro';
import EmailCapture from '../components/EmailCapture.astro';
import ProTips from '../components/ProTips.astro';
import RelatedPages from '../components/RelatedPages.astro';
import FaqSection from '../components/FaqSection.astro';
import type { FaqItem } from '../components/FaqSection.astro';
import type { CalculatorPage } from '../lib/types';
import { isIndexable, INDEXABLE_GUEST_COUNTS } from '../data/indexing';
import { FLUTES_PER_BOTTLE, toastBottles } from '../data/items';
import { totalCalculatorsLabel } from '../data';
import { formatSharePercent } from '../data/eventSplits';
import {
  BASE_DRINKS_PER_HOUR,
  BUFFER_PERCENTAGE,
  HOURLY_DECAY,
  DRINKING_PERCENTAGE,
} from '../data/model';

const QUICK_REFERENCE_GUEST_COUNTS = INDEXABLE_GUEST_COUNTS;
const CALCULATORS_DIR = path.join(process.cwd(), 'src/content/calculators');

/**
 * Reads a sibling drink page's own generated data, so a quick-reference row
 * shows exactly what its linked page shows rather than a scaled estimate.
 * Returns null if that page was never generated.
 */
function readSiblingCalculatorPage(itemId: string, eventSlug: string, guests: number): CalculatorPage | null {
  const filePath = path.join(CALCULATORS_DIR, `${itemId}-for-${eventSlug}-${guests}-guests.json`);
  if (!fs.existsSync(filePath)) return null;
  return JSON.parse(fs.readFileSync(filePath, 'utf-8'));
}

export async function getStaticPaths() {
  // Read all calculator JSON files directly
  const calcDir = path.join(process.cwd(), 'src/content/calculators');

  // Check if directory exists
  if (!fs.existsSync(calcDir)) {
    return [];
  }

  const files = fs.readdirSync(calcDir).filter(f => f.endsWith('.json') && !f.startsWith('_'));

  return files.map((file) => {
    const dataPath = path.join(calcDir, file);
    const pageData: CalculatorPage = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
    const slug = file.replace('.json', '');

    return {
      params: { slug },
      props: { page: pageData },
    };
  });
}

interface Props {
  page: CalculatorPage;
}

const { page } = Astro.props;

// Quick-reference rows read each sibling page's own generated numbers rather
// than scaling this page's numbers by a guest ratio: drinking rate varies by
// guest tier, so a scaled row can disagree with the page it links to. A guest
// count with no generated page is skipped rather than estimated.
const quickReferenceRows = QUICK_REFERENCE_GUEST_COUNTS
  .map((guests) => {
    const sibling = readSiblingCalculatorPage(page.item.id, page.event.slug, guests);
    if (!sibling) return null;
    return {
      guests,
      fullBar: sibling.calculation.fullBar,
      toast: page.calculation.toastBottles !== undefined ? toastBottles(guests, BUFFER_PERCENTAGE) : null,
      isCurrentRow: guests === page.guestCount.value,
    };
  })
  .filter((row): row is NonNullable<typeof row> => row !== null);

// Breadcrumbs for structured data
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Calculators', url: '/calculators/' },
  { name: page.item.name, url: `/calculators/${page.item.id}/` },
  { name: `${page.guestCount.value} Guests`, url: `/${page.slug}/` }
];

// HowTo Schema - optimized for AIO
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": `Calculate ${page.item.name} for ${page.guestCount.value} Guests`,
  "description": page.meta.description,
  "step": page.mathExplanation.map((step, i) => ({
    "@type": "HowToStep",
    "position": i + 1,
    "name": step.label,
    "text": `${step.formula} = ${step.result}. ${step.explanation}`,
  })),
  "totalTime": "PT30S",
  "tool": [{ "@type": "HowToTool", "name": "StockTheEvent Calculator" }],
  "supply": [{ "@type": "HowToSupply", "name": `${page.calculation.unitsNeeded} ${page.calculation.unitsDisplay} of ${page.item.name.toLowerCase()}` }]
};

// FAQ built once, then fed to both the visible section and the JSON-LD so the
// two cannot drift apart.
const drink = page.item.name.toLowerCase();
const eventName = page.event.lowerName;
const fullBar = page.calculation.fullBar;
const onlyDrink = page.calculation.onlyDrink;
const sharePercent = formatSharePercent(page.calculation.barShare);

const faqItems: FaqItem[] = [
  {
    question: `How much ${drink} do I need for ${page.guestCount.value} guests?`,
    answer: `You need ${fullBar.unitsNeeded} ${fullBar.unitsDisplay} of ${drink} for ${page.guestCount.value} guests at a ${eventName}, assuming you are serving a full bar. That is ${fullBar.totalServings} servings with a 15% buffer. If ${drink} is the only alcohol you serve, plan on ${onlyDrink.unitsNeeded} ${onlyDrink.unitsDisplay} instead.`,
  },
  {
    question: `How much ${drink} per person for a ${eventName}?`,
    answer: `Plan for ${fullBar.perPersonServings} servings of ${drink} per person at a ${eventName} with a full bar. This accounts for the fact that not everyone drinks alcohol, that consumption slows as the event progresses, and that ${drink} is only ${sharePercent} percent of what gets poured.`,
  },
  {
    question: `How many servings are in a ${page.item.unitSingular} of ${drink}?`,
    answer: `One ${page.item.unitSingular} of ${drink} contains ${page.item.servingsPerUnit} servings. For ${page.guestCount.value} guests, you'll need ${fullBar.unitsNeeded} ${fullBar.unitsDisplay} to provide ${fullBar.totalServings} total servings.`,
  },
  {
    question: `What percentage of the bar is ${drink} at a ${eventName}?`,
    answer: `About ${sharePercent} percent of the drinks poured at a ${eventName} are ${drink}. With ${page.guestCount.value} guests, roughly ${page.calculation.actualDrinkers} will be drinking, and that share works out to ${fullBar.unitsNeeded} ${fullBar.unitsDisplay}.`,
  },
  {
    question: `Should I buy extra ${drink} as a buffer?`,
    answer: `Our figure of ${fullBar.unitsNeeded} ${fullBar.unitsDisplay} already includes a 15% buffer (${fullBar.buffer} extra ${fullBar.unitsDisplay}). That covers guests who drink more than average. It is always better to have leftovers than to run short.`,
  },
  {
    question: `How long will ${fullBar.unitsNeeded} ${fullBar.unitsDisplay} of ${drink} last for ${page.guestCount.value} guests?`,
    answer: `${fullBar.unitsNeeded} ${fullBar.unitsDisplay} of ${drink} will last approximately ${page.event.defaultDuration} hours for ${page.guestCount.value} guests at a ${eventName}, alongside the other drinks on the bar. This factors in the natural slowdown of consumption as the event progresses.`,
  },
  ...(page.calculation.toastBottles
    ? [{
        question: `How much champagne do I need for just the toast?`,
        answer: `For a toast alone, plan on ${page.calculation.toastBottles} bottles. That is one flute for every one of your ${page.guestCount.value} guests, not just the drinkers, since everyone takes a glass for the toast, at about ${FLUTES_PER_BOTTLE} flutes per bottle with the same 15% buffer.`,
      }]
    : []),
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};

// ItemList Schema for shopping list
const shoppingListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Shopping List: ${page.item.name} for ${page.guestCount.value} Guest ${page.event.name}`,
  "numberOfItems": page.shoppingList.length,
  "itemListElement": page.shoppingList.map((item, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": `${item.quantity} ${item.unit} ${item.name}`,
    "description": item.notes || undefined
  }))
};
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  breadcrumbs={breadcrumbs}
  calculatorHref={`/bar-setup/${page.event.slug}-${page.guestCount.value}-guests/`}
>
  <!-- JSON-LD Schema -->
  <Fragment slot="head">
    {!isIndexable(page.guestCount.value) && (
      <meta name="robots" content="noindex, follow" />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(shoppingListSchema)} />
  </Fragment>

  <!-- Bar Setup Context Banner (shown when coming from bar-setup page) -->
  <div id="bar-context-banner" class="hidden forest-gradient text-white py-4">
    <div class="max-w-4xl mx-auto px-4">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <Icon name={page.item.icon} size={28} />
          <div>
            <div class="font-semibold">As part of your bar setup:</div>
            <div class="text-white/80">
              You need <span id="bar-units" class="font-bold text-white">--</span> {page.item.unit}
              (<span id="bar-servings" class="font-medium">--</span> servings)
            </div>
          </div>
        </div>
        <a href="#" id="back-to-bar" class="bg-white/20 hover:bg-white/30 px-4 py-2 rounded-lg text-sm font-medium transition-colors">
          ← Back to Bar Setup
        </a>
      </div>
    </div>
  </div>

  <!-- Drink Switcher -->
  <DrinkSwitcher
    currentItemId={page.item.id}
    eventSlug={page.event.slug}
    guestCount={page.guestCount.value}
  />

  <!-- Hero with Main Answer -->
  <AnswerHero
    item={page.item}
    event={page.event}
    guestCount={page.guestCount}
    calculation={page.calculation}
    h1={page.meta.h1}
  />

  <!-- Secondary answers: the only-drink case, and the toast for champagne -->
  <section class="pb-4">
    <div class="max-w-4xl mx-auto px-4">
      <div class="border-t border-b border-[var(--rule,#C7CDC8)] py-4 text-center">
        <p class="answer-only-drink text-[var(--chocolate-light)] tabular-nums">
          If {page.item.name.toLowerCase()} is the only alcohol you serve:
          <span class="font-semibold text-[var(--chocolate)]">{page.calculation.onlyDrink.unitsNeeded} {page.calculation.onlyDrink.unitsDisplay}</span>
        </p>
        <p class="answer-full-bar mt-2">
          <a href={`/bar-setup/${page.event.slug}-${page.guestCount.value}-guests/`}>
            Planning a full bar? See wine, beer, spirits, and champagne together for this {page.event.lowerName}
          </a>
        </p>
        {page.calculation.toastBottles && (
          <p class="answer-toast text-[var(--chocolate-light)] tabular-nums mt-2">
            For a toast only:
            <span class="font-semibold text-[var(--chocolate)]">{page.calculation.toastBottles} bottles</span>
            (one flute per guest, about {FLUTES_PER_BOTTLE} flutes per bottle, with the same buffer)
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- Math Breakdown -->
  <MathBreakdown steps={page.mathExplanation} />

  <!-- Quick Reference Table (for featured snippets) -->
  <section class="py-10 bg-white">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="font-display text-xl font-bold text-slate-900 mb-4 flex items-center gap-2">
        Quick Reference: {page.item.name} by Guest Count
      </h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-slate-100">
              <th class="px-4 py-3 text-left font-semibold text-slate-700 border-b border-slate-200">Guests</th>
              <th class="px-4 py-3 text-left font-semibold text-slate-700 border-b border-slate-200">{page.item.name} on a Full Bar</th>
              {page.calculation.toastBottles && (
                <th class="px-4 py-3 text-left font-semibold text-slate-700 border-b border-slate-200">Toast Only</th>
              )}
              <th class="px-4 py-3 text-left font-semibold text-slate-700 border-b border-slate-200">Total Servings</th>
            </tr>
          </thead>
          <tbody>
            {quickReferenceRows.map((row) => (
              <tr class={row.isCurrentRow ? 'bg-emerald-50 font-semibold' : 'hover:bg-slate-50'}>
                <td class="px-4 py-3 border-b border-slate-100 tabular-nums">
                  {row.guests} guests {row.isCurrentRow && <span class="text-emerald-600 text-xs ml-1">(you)</span>}
                </td>
                <td class="px-4 py-3 border-b border-slate-100 tabular-nums">
                  <a href={`/${page.item.id}-for-${page.event.slug}-${row.guests}-guests/`}
                     class={`${row.isCurrentRow ? 'text-emerald-700' : 'text-emerald-600 hover:underline'}`}>
                    {row.fullBar.unitsNeeded} {row.fullBar.unitsDisplay}
                  </a>
                </td>
                {row.toast !== null && (
                  <td class="px-4 py-3 border-b border-slate-100 tabular-nums">{row.toast} bottles</td>
                )}
                <td class="px-4 py-3 border-b border-slate-100 tabular-nums">{row.fullBar.totalServings} servings</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-slate-500 mt-3">
        * All calculations include a 15% buffer. Amounts for a {page.event.lowerName} serving a full bar.
      </p>
    </div>
  </section>

  <!-- FAQ (same questions as the JSON-LD above) -->
  <FaqSection
    heading={`Questions about ${page.item.name.toLowerCase()} for a ${page.event.lowerName}`}
    items={faqItems}
  />

  <!-- Shopping List -->
  <ShoppingList items={page.shoppingList} mainItem={page.item} />

  <!-- Email Capture -->
  <div class="max-w-3xl mx-auto px-4">
    <EmailCapture
      eventType={page.event.id}
      eventName={page.event.name}
      guestCount={page.guestCount.value}
      shoppingList={page.shoppingList}
      placement="inline"
    />
  </div>

  <!-- Pro Tips -->
  <ProTips event={page.event} />

  <!-- Related Pages -->
  <RelatedPages
    pages={page.relatedPages}
    currentEvent={page.event.name}
    currentGuests={page.guestCount.value}
  />

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-br from-amber-500 via-orange-500 to-orange-600 relative overflow-hidden">
    <!-- Decorative elements -->
    <div class="absolute top-0 left-0 w-64 h-64 bg-white/10 rounded-full -translate-x-1/2 -translate-y-1/2"></div>
    <div class="absolute bottom-0 right-0 w-48 h-48 bg-white/10 rounded-full translate-x-1/2 translate-y-1/2"></div>
    <div class="absolute top-1/2 right-10 w-24 h-24 bg-white/5 rounded-full hidden md:block"></div>

    <div class="max-w-3xl mx-auto px-4 text-center relative z-10">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-4">
        Planning a different event?
      </h2>
      <p class="text-amber-100 mb-8 text-lg max-w-xl mx-auto">
        Use our free calculator for any combination of drinks, events, and guest counts.
      </p>
      <a
        href="/calculators/"
        class="inline-block bg-white text-amber-600 px-8 py-4 rounded-xl font-bold hover:bg-amber-50 hover:scale-105 transition-all shadow-xl"
      >
        Browse All {totalCalculatorsLabel()} Calculators
      </a>
    </div>
  </section>
</BaseLayout>

<script define:vars={{
  eventSlug: page.event.slug,
  guestCount: page.guestCount.value,
  itemData: { servingsPerUnit: page.item.servingsPerUnit, unit: page.item.unit, unitSingular: page.item.unitSingular, name: page.item.name },
  eventModifier: page.event.modifiers[page.item.id] || 1.0,
  eventDuration: page.event.defaultDuration,
  barShare: page.calculation.barShare,
  BASE_DRINKS_PER_HOUR,
  BUFFER_PERCENTAGE,
  HOURLY_DECAY,
  DRINKING_PERCENTAGE
}}>
  // Model constants arrive from src/data/model.ts via define:vars rather than
  // being redeclared here, so this recalculation cannot drift from the generator.

  function getTier(guests) {
    if (guests <= 30) return 'small';
    if (guests <= 75) return 'medium';
    if (guests <= 150) return 'large';
    return 'xlarge';
  }

  function calculateConsumption(durationHours) {
    let total = 0;
    for (let hour = 0; hour < durationHours; hour++) {
      const decayIndex = Math.min(hour, HOURLY_DECAY.length - 1);
      total += HOURLY_DECAY[decayIndex];
    }
    return total;
  }

  // Mirrors scripts/generateData.ts: full bar is the primary answer, so the
  // share is applied before converting to units. Without this the ?guests=
  // override would quietly swap the headline back to the only-drink figure.
  function recalculate(guests, duration) {
    const tier = getTier(guests);
    const drinkingPct = DRINKING_PERCENTAGE[tier];
    const actualDrinkers = guests * drinkingPct;
    const consumptionMult = calculateConsumption(duration);
    const onlyDrinkServings = Math.round(actualDrinkers * BASE_DRINKS_PER_HOUR * consumptionMult * eventModifier);

    const totalServings = Math.round(onlyDrinkServings * barShare);
    const rawUnits = totalServings / itemData.servingsPerUnit;
    const unitsNeeded = Math.ceil(rawUnits * (1 + BUFFER_PERCENTAGE));
    const perPerson = Math.round((totalServings / guests) * 10) / 10;
    const buffer = Math.ceil(rawUnits * BUFFER_PERCENTAGE);

    const onlyDrinkUnits = Math.ceil((onlyDrinkServings / itemData.servingsPerUnit) * (1 + BUFFER_PERCENTAGE));

    return { unitsNeeded, totalServings, perPerson, buffer, onlyDrinkUnits, onlyDrinkServings };
  }

  // Check URL parameters
  const urlParams = new URLSearchParams(window.location.search);
  const fromBar = urlParams.get('fromBar');
  const units = urlParams.get('units');
  const servings = urlParams.get('servings');
  const customGuests = urlParams.get('guests');
  const customDuration = urlParams.get('duration');

  // If custom guest count provided, recalculate and update display
  if (customGuests && parseInt(customGuests) !== guestCount) {
    const newGuests = parseInt(customGuests);
    const duration = customDuration ? parseInt(customDuration) : eventDuration;
    const calc = recalculate(newGuests, duration);

    // Update the main answer number
    const answerNumber = document.querySelector('.answer-number');
    if (answerNumber) answerNumber.textContent = calc.unitsNeeded;

    // Update unit label
    const unitLabel = document.querySelector('.font-display.text-xl, .font-display.text-2xl');
    if (unitLabel) {
      const unitText = calc.unitsNeeded === 1 ? itemData.unitSingular : itemData.unit;
      unitLabel.textContent = `${unitText} of ${itemData.name.toLowerCase()}`;
    }

    // Update stats cards
    const statsCards = document.querySelectorAll('.glass-card .font-mono-luxe');
    if (statsCards.length >= 3) {
      statsCards[0].textContent = calc.totalServings;
      statsCards[1].textContent = calc.perPerson;
      statsCards[2].textContent = '+' + calc.buffer;
    }

    // Update the "For X-guest" text
    const guestCountDisplay = document.getElementById('guest-count-display');
    if (guestCountDisplay) {
      guestCountDisplay.textContent = newGuests.toString();
    }

    // Update H1 if it contains guest count
    const h1 = document.querySelector('h1');
    if (h1 && h1.textContent.includes(guestCount)) {
      h1.textContent = h1.textContent.replace(guestCount, newGuests);
    }
  }

  // Bar context banner handling
  if (fromBar === '1' && units && servings) {
    const banner = document.getElementById('bar-context-banner');
    const barUnits = document.getElementById('bar-units');
    const barServings = document.getElementById('bar-servings');
    const backLink = document.getElementById('back-to-bar');

    if (banner) banner.classList.remove('hidden');
    if (barUnits) barUnits.textContent = units;
    if (barServings) barServings.textContent = servings;
    if (backLink) {
      const guests = customGuests || guestCount;
      backLink.href = `/bar-setup/${eventSlug}-${guests}-guests/`;
    }
  }
</script>
