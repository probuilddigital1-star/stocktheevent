---
import * as fs from 'fs';
import * as path from 'path';
import BaseLayout from '../layouts/BaseLayout.astro';
import AnswerHeader from '../components/AnswerHeader.astro';
import AdjustBox from '../components/AdjustBox.astro';
import HowWeGotThere from '../components/HowWeGotThere.astro';
import QuickReference from '../components/QuickReference.astro';
import type { QuickReferenceRow, QuickReferenceColumn } from '../components/QuickReference.astro';
import ShoppingChecklist from '../components/ShoppingChecklist.astro';
import CrossPromo from '../components/CrossPromo.astro';
import FaqSection from '../components/FaqSection.astro';
import type { FaqItem } from '../components/FaqSection.astro';
import RelatedPages from '../components/RelatedPages.astro';
import type { CalculatorPage } from '../lib/types';
import { items } from '../data/items';
import { isIndexable, INDEXABLE_GUEST_COUNTS } from '../data/indexing';
import { FLUTES_PER_BOTTLE } from '../data/items';
import { formatSharePercent } from '../data/eventSplits';
import {
  BASE_DRINKS_PER_HOUR,
  BUFFER_PERCENTAGE,
  HOURLY_DECAY,
  DRINKING_PERCENTAGE,
} from '../data/model';

const QUICK_REFERENCE_GUEST_COUNTS = INDEXABLE_GUEST_COUNTS;
const CALCULATORS_DIR = path.join(process.cwd(), 'src/content/calculators');

/**
 * Reads a sibling drink page's own generated data, so a quick-reference row
 * shows exactly what its linked page shows rather than a scaled estimate.
 * Returns null if that page was never generated.
 */
function readSiblingCalculatorPage(itemId: string, eventSlug: string, guests: number): CalculatorPage | null {
  const filePath = path.join(CALCULATORS_DIR, `${itemId}-for-${eventSlug}-${guests}-guests.json`);
  if (!fs.existsSync(filePath)) return null;
  return JSON.parse(fs.readFileSync(filePath, 'utf-8'));
}

export async function getStaticPaths() {
  // Read all calculator JSON files directly
  const calcDir = path.join(process.cwd(), 'src/content/calculators');

  // Check if directory exists
  if (!fs.existsSync(calcDir)) {
    return [];
  }

  const files = fs.readdirSync(calcDir).filter(f => f.endsWith('.json') && !f.startsWith('_'));

  return files.map((file) => {
    const dataPath = path.join(calcDir, file);
    const pageData: CalculatorPage = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
    const slug = file.replace('.json', '');

    return {
      params: { slug },
      props: { page: pageData },
    };
  });
}

interface Props {
  page: CalculatorPage;
}

const { page } = Astro.props;

// How the serving is called when talking about this drink.
const SERVING_WORDS: Record<string, string> = {
  wine: 'glasses',
  beer: 'servings',
  champagne: 'flutes',
  spirits: 'drinks',
};
const servingWord = SERVING_WORDS[page.item.id] ?? 'servings';

// "about 3 1/2 cases" for bottle-counted drinks with enough volume; cans for beer.
function fractionLabel(value: number): string {
  const halves = Math.round(value * 2);
  const whole = Math.floor(halves / 2);
  const hasHalf = halves % 2 === 1;
  if (whole === 0) return hasHalf ? '1/2' : '0';
  return hasHalf ? `${whole} 1/2` : `${whole}`;
}

function buildContextLine(units: number, servings: number, duration: number): string {
  const parts = [`as part of a full bar, ${duration} hours`];
  if (page.item.unit === 'bottles' && units >= 6) {
    const cases = fractionLabel(units / 12);
    parts.push(`about ${cases} ${cases === '1' ? 'case' : 'cases'}`);
  }
  if (page.item.id === 'beer') {
    parts.push(`${units * 24} cans`);
  }
  parts.push(`${servings} ${servingWord}`);
  return parts.join(' · ');
}

const fullBar = page.calculation.fullBar;
const onlyDrink = page.calculation.onlyDrink;
const drink = page.item.name.toLowerCase();
const eventName = page.event.lowerName;
const sharePercent = formatSharePercent(page.calculation.barShare);

const contextLine = buildContextLine(fullBar.unitsNeeded, fullBar.totalServings, page.event.defaultDuration);
const unitLine = `${fullBar.unitsDisplay} of ${drink}`;

const whereToBuyCasesLabel =
  page.item.unit === 'bottles' && fullBar.unitsNeeded >= 6 ? fractionLabel(fullBar.unitsNeeded / 12) : undefined;

// Quick-reference rows read each sibling page's own generated numbers rather
// than scaling this page's numbers by a guest ratio: drinking rate varies by
// guest tier, so a scaled row can disagree with the page it links to. A guest
// count with no generated page is skipped rather than estimated.
const hasToastColumn = page.calculation.toastBottles !== undefined;
const quickReferenceRows: QuickReferenceRow[] = QUICK_REFERENCE_GUEST_COUNTS
  .map((guests) => {
    const sibling = readSiblingCalculatorPage(page.item.id, page.event.slug, guests);
    if (!sibling) return null;
    const isCurrent = guests === page.guestCount.value;
    return {
      guests,
      href: isCurrent ? null : `/${page.item.id}-for-${page.event.slug}-${guests}-guests/`,
      values: [
        { value: String(sibling.calculation.fullBar.unitsNeeded), unit: sibling.calculation.fullBar.unitsDisplay },
        { value: String(sibling.calculation.onlyDrink.unitsNeeded), unit: sibling.calculation.onlyDrink.unitsDisplay },
        ...(hasToastColumn ? [{ value: String(sibling.calculation.toastBottles), unit: 'bottles' }] : []),
        { value: String(sibling.calculation.fullBar.totalServings) },
      ],
      isCurrent,
    };
  })
  .filter((row): row is QuickReferenceRow => row !== null);

const quickReferenceColumns: QuickReferenceColumn[] = [
  { label: 'Full bar', unit: page.item.unit },
  { label: `${page.item.name} only`, unit: page.item.unit },
  ...(hasToastColumn ? [{ label: 'Toast', unit: 'bottles' }] : []),
  { label: 'Servings' },
];

// The other three drinks at this event, for the Adjust box.
const otherDrinks = items
  .filter((item) => item.id !== page.item.id)
  .map((item) => ({
    href: `/${item.id}-for-${page.event.slug}-${page.guestCount.value}-guests/`,
    label: item.name,
    icon: item.icon,
  }));

const barSetupHref = `/bar-setup/${page.event.slug}-${page.guestCount.value}-guests/`;

// How each shopping row's quantity derives from the calculation, matched to
// scripts/generateData.ts, so the client script can update quantities live.
// "main" is the headline unit count; "<base><op><n>" is ceil(base op n).
const SHOPPING_ROW_CALCS: Record<string, string[]> = {
  wine: ['main', 'static', 'drinkers*2'],
  beer: ['main', 'units*12', 'units/2'],
  champagne: ['main', 'drinkers*1.5', 'units/4'],
  spirits: ['main', 'servings/3', 'drinkers*2', 'drinkers*2', 'servings/8'],
};
const rowCalcs = SHOPPING_ROW_CALCS[page.item.id] ?? [];

// Breadcrumbs for structured data
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Calculators', url: '/calculators/' },
  { name: page.item.name, url: `/calculators/${page.item.id}/` },
  { name: `${page.guestCount.value} Guests`, url: `/${page.slug}/` }
];

const crumbs = [
  { label: 'Drinks', href: '/calculators/' },
  { label: page.item.name, href: `/calculators/${page.item.id}/` },
  { label: page.event.name, href: `/calculators/${page.event.id}/` },
];

// HowTo Schema - optimized for AIO
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": `Calculate ${page.item.name} for ${page.guestCount.value} Guests`,
  "description": page.meta.description,
  "step": page.mathExplanation.map((step, i) => ({
    "@type": "HowToStep",
    "position": i + 1,
    "name": step.label,
    "text": `${step.formula} = ${step.result}. ${step.explanation}`,
  })),
  "totalTime": "PT30S",
  "tool": [{ "@type": "HowToTool", "name": "StockTheEvent Calculator" }],
  "supply": [{ "@type": "HowToSupply", "name": `${page.calculation.unitsNeeded} ${page.calculation.unitsDisplay} of ${page.item.name.toLowerCase()}` }]
};

// FAQ built once, then fed to both the visible section and the JSON-LD so the
// two cannot drift apart.
const faqItems: FaqItem[] = [
  {
    question: `How much ${drink} do I need for ${page.guestCount.value} guests?`,
    answer: `You need ${fullBar.unitsNeeded} ${fullBar.unitsDisplay} of ${drink} for ${page.guestCount.value} guests at a ${eventName}, assuming you are serving a full bar. That is ${fullBar.totalServings} servings with a 15% buffer. If ${drink} is the only alcohol you serve, plan on ${onlyDrink.unitsNeeded} ${onlyDrink.unitsDisplay} instead.`,
  },
  {
    question: `How much ${drink} per person for a ${eventName}?`,
    answer: `Plan for ${fullBar.perPersonServings} servings of ${drink} per person at a ${eventName} with a full bar. This accounts for the fact that not everyone drinks alcohol, that consumption slows as the event progresses, and that ${drink} is only ${sharePercent} percent of what gets poured.`,
  },
  {
    question: `How many servings are in a ${page.item.unitSingular} of ${drink}?`,
    answer: `One ${page.item.unitSingular} of ${drink} contains ${page.item.servingsPerUnit} servings. For ${page.guestCount.value} guests, you'll need ${fullBar.unitsNeeded} ${fullBar.unitsDisplay} to provide ${fullBar.totalServings} total servings.`,
  },
  {
    question: `What percentage of the bar is ${drink} at a ${eventName}?`,
    answer: `About ${sharePercent} percent of the drinks poured at a ${eventName} are ${drink}. With ${page.guestCount.value} guests, roughly ${page.calculation.actualDrinkers} will be drinking, and that share works out to ${fullBar.unitsNeeded} ${fullBar.unitsDisplay}.`,
  },
  {
    question: `Should I buy extra ${drink} as a buffer?`,
    answer: `Our figure of ${fullBar.unitsNeeded} ${fullBar.unitsDisplay} already includes a 15% buffer (${fullBar.buffer} extra ${fullBar.unitsDisplay}). That covers guests who drink more than average. It is always better to have leftovers than to run short.`,
  },
  {
    question: `How long will ${fullBar.unitsNeeded} ${fullBar.unitsDisplay} of ${drink} last for ${page.guestCount.value} guests?`,
    answer: `${fullBar.unitsNeeded} ${fullBar.unitsDisplay} of ${drink} will last approximately ${page.event.defaultDuration} hours for ${page.guestCount.value} guests at a ${eventName}, alongside the other drinks on the bar. This factors in the natural slowdown of consumption as the event progresses.`,
  },
  ...(page.calculation.toastBottles
    ? [{
        question: `How much champagne do I need for just the toast?`,
        answer: `For a toast alone, plan on ${page.calculation.toastBottles} bottles. That is one flute for every one of your ${page.guestCount.value} guests, not just the drinkers, since everyone takes a glass for the toast, at about ${FLUTES_PER_BOTTLE} flutes per bottle with the same 15% buffer.`,
      }]
    : []),
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};

// ItemList Schema for shopping list
const shoppingListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Shopping List: ${page.item.name} for ${page.guestCount.value} Guest ${page.event.name}`,
  "numberOfItems": page.shoppingList.length,
  "itemListElement": page.shoppingList.map((item, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": `${item.quantity} ${item.unit} ${item.name}`,
    "description": item.notes || undefined
  }))
};
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  breadcrumbs={breadcrumbs}
  calculatorHref={barSetupHref}
>
  <!-- JSON-LD Schema -->
  <Fragment slot="head">
    {!isIndexable(page.guestCount.value) && (
      <meta name="robots" content="noindex, follow" />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(shoppingListSchema)} />
  </Fragment>

  <AnswerHeader
    crumbs={crumbs}
    h1={page.meta.h1}
    units={fullBar.unitsNeeded}
    unitLine={unitLine}
    contextLine={contextLine}
    onlyDrink={{
      lead: `If ${drink} is the only alcohol you serve`,
      figure: `${onlyDrink.unitsNeeded} ${onlyDrink.unitsDisplay}`,
      perGuest: `(${onlyDrink.perPersonServings} ${servingWord} per guest)`,
    }}
    toast={page.calculation.toastBottles
      ? {
          figure: `${page.calculation.toastBottles} bottles`,
          note: `(one flute per guest at ${FLUTES_PER_BOTTLE} flutes per bottle, with the same buffer)`,
        }
      : undefined}
  >
    <AdjustBox
      slot="aside"
      guests={page.guestCount.value}
      hours={page.event.defaultDuration}
      othersLabel={`Also at this ${eventName}`}
      others={otherDrinks}
      primaryHref={barSetupHref}
      primaryLabel={`Plan the whole bar for this ${eventName}`}
    />
  </AnswerHeader>

  <HowWeGotThere
    title={`${['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight'][page.mathExplanation.length] ?? page.mathExplanation.length} lines of arithmetic`}
    note="Change any assumption you disagree with; the answer follows."
    steps={page.mathExplanation}
  >
    <p class="knot-line num">
      The Knot's wedding guide plans one drink per guest per hour with a 50/25/25
      liquor, beer and wine split. This model counts only the guests who drink,
      slows the pace after the first hour, and keeps a 15 percent margin;
      <a href="/methodology/">read the methodology</a>.
    </p>
  </HowWeGotThere>

  <QuickReference
    title={`${page.item.name} for a ${eventName}, by guest count`}
    columns={quickReferenceColumns}
    rows={quickReferenceRows}
    footnote={`Full bar figures are ${drink}'s share of a four-drink bar for a ${eventName}, with a 15 percent buffer included.`}
  />

  <ShoppingChecklist
    items={page.shoppingList}
    rowCalcs={rowCalcs}
    buyLabel={`${fullBar.unitsNeeded} ${fullBar.unitsDisplay}`}
    whereToBuyItemId={page.item.id}
    whereToBuyQuantity={fullBar.unitsNeeded}
    whereToBuyUnit={fullBar.unitsDisplay}
    whereToBuyCasesLabel={whereToBuyCasesLabel}
  />

  {page.item.id === 'spirits' && <CrossPromo />}

  <FaqSection
    heading={`${page.item.name} at a ${eventName}`}
    items={faqItems}
  />

  <RelatedPages
    pages={page.relatedPages}
    currentEvent={page.event.name}
    currentItem={page.item.name}
  />
</BaseLayout>

<style>
  .knot-line {
    margin: 14px 0 0;
    font-size: 14px;
    color: var(--ink-2);
    max-width: 62ch;
  }
</style>

<script define:vars={{
  guestCount: page.guestCount.value,
  eventDuration: page.event.defaultDuration,
  itemData: {
    id: page.item.id,
    servingsPerUnit: page.item.servingsPerUnit,
    unit: page.item.unit,
    unitSingular: page.item.unitSingular,
    name: page.item.name,
  },
  eventModifier: page.event.modifiers[page.item.id] || 1.0,
  barShare: page.calculation.barShare,
  sharePercent,
  servingWord,
  flutesPerBottle: FLUTES_PER_BOTTLE,
  isChampagne: page.calculation.toastBottles !== undefined,
  BASE_DRINKS_PER_HOUR,
  BUFFER_PERCENTAGE,
  HOURLY_DECAY,
  DRINKING_PERCENTAGE
}}>
  // Model constants arrive from src/data/model.ts via define:vars rather than
  // being redeclared here, so this recalculation cannot drift from the
  // generator. The steppers rewrite the answer, the math ledger, the
  // quick-reference highlight and the shopping list, and mirror the state
  // into the URL with replaceState.

  const drinkName = itemData.name.toLowerCase();

  function getTier(guests) {
    if (guests <= 30) return 'small';
    if (guests <= 75) return 'medium';
    if (guests <= 150) return 'large';
    return 'xlarge';
  }

  function calculateConsumption(durationHours) {
    let total = 0;
    for (let hour = 0; hour < durationHours; hour++) {
      const decayIndex = Math.min(hour, HOURLY_DECAY.length - 1);
      total += HOURLY_DECAY[decayIndex];
    }
    return total;
  }

  // Mirrors scripts/generateData.ts: full bar is the primary answer, so the
  // share is applied before converting to units.
  function recalculate(guests, duration) {
    const tier = getTier(guests);
    const drinkingPct = DRINKING_PERCENTAGE[tier];
    const drinkers = Math.round(guests * drinkingPct);
    const consumptionMult = calculateConsumption(duration);

    const onlyServings = Math.round(guests * drinkingPct * BASE_DRINKS_PER_HOUR * consumptionMult * eventModifier);
    const fullServings = Math.round(onlyServings * barShare);

    const rawUnitsExact = fullServings / itemData.servingsPerUnit;
    const unitsNeeded = Math.ceil(rawUnitsExact * (1 + BUFFER_PERCENTAGE));
    const rawUnits = Math.round(rawUnitsExact * 10) / 10;

    const onlyRawExact = onlyServings / itemData.servingsPerUnit;
    const onlyUnits = Math.ceil(onlyRawExact * (1 + BUFFER_PERCENTAGE));

    return {
      tier, drinkingPct, drinkers, consumptionMult,
      onlyServings, fullServings, rawUnits, unitsNeeded, onlyUnits,
      perPersonFull: Math.round((fullServings / guests) * 10) / 10,
      perPersonOnly: Math.round((onlyServings / guests) * 10) / 10,
      toastBottles: Math.ceil((guests / flutesPerBottle) * (1 + BUFFER_PERCENTAGE)),
    };
  }

  function unitsDisplay(units) {
    return units === 1 ? itemData.unitSingular : itemData.unit;
  }

  function fractionLabel(value) {
    const halves = Math.round(value * 2);
    const whole = Math.floor(halves / 2);
    const hasHalf = halves % 2 === 1;
    if (whole === 0) return hasHalf ? '1/2' : '0';
    return hasHalf ? `${whole} 1/2` : `${whole}`;
  }

  function contextLine(calc, duration) {
    const parts = [`as part of a full bar, ${duration} hours`];
    if (itemData.unit === 'bottles' && calc.unitsNeeded >= 6) {
      const cases = fractionLabel(calc.unitsNeeded / 12);
      parts.push(`about ${cases} ${cases === '1' ? 'case' : 'cases'}`);
    }
    if (itemData.id === 'beer') {
      parts.push(`${calc.unitsNeeded * 24} cans`);
    }
    parts.push(`${calc.fullServings} ${servingWord}`);
    return parts.join(' · ');
  }

  // A null formula leaves the build-time formula in place (the modifier step
  // does not change with guests or hours).
  function setMathStep(step, formula, result) {
    const row = document.querySelector(`[data-math-step="${step}"]`);
    if (!row) return;
    const formulaEl = row.querySelector('.math-formula');
    const resultEl = row.querySelector('.math-result');
    if (formulaEl && formula !== null) formulaEl.textContent = formula;
    if (resultEl) resultEl.textContent = result;
  }

  function updateMathLedger(calc, guests, duration) {
    const pctLabel = Math.round(calc.drinkingPct * 100);
    setMathStep(1, `${guests} guests × ${pctLabel}% drinking rate`, `${calc.drinkers} drinkers`);
    setMathStep(2,
      `${calc.drinkers} drinkers × ${BASE_DRINKS_PER_HOUR} drinks/hour × ${duration} hours`,
      `${Math.round(calc.drinkers * BASE_DRINKS_PER_HOUR * duration)} base drinks`);
    setMathStep(3,
      `Adjusted for drinking slowdown over time (decay factor: ${calc.consumptionMult.toFixed(2)})`,
      `${Math.round(calc.drinkers * BASE_DRINKS_PER_HOUR * calc.consumptionMult)} adjusted drinks`);
    setMathStep(4, null, `${calc.onlyServings} ${drinkName} servings if served alone`);
    setMathStep(5,
      `${calc.onlyServings} servings × ${sharePercent}%`,
      `${calc.fullServings} ${drinkName} servings`);
    setMathStep(6,
      `${calc.fullServings} servings ÷ ${itemData.servingsPerUnit} servings per ${itemData.unitSingular}`,
      `${calc.rawUnits} ${itemData.unit} (raw)`);
    setMathStep(7,
      `${calc.rawUnits} × 1.15 = ${(calc.rawUnits * 1.15).toFixed(1)}, rounded up`,
      `${calc.unitsNeeded} ${unitsDisplay(calc.unitsNeeded)}`);
  }

  function updateQuickReference(guests) {
    const rows = document.querySelectorAll('#quick-reference tbody tr[data-guests]');
    if (!rows.length) return;
    let nearest = null;
    let minDiff = Infinity;
    rows.forEach(row => {
      const value = parseInt(row.getAttribute('data-guests') || '0', 10);
      const diff = Math.abs(value - guests);
      if (diff < minDiff) {
        minDiff = diff;
        nearest = row;
      }
    });
    rows.forEach(row => row.classList.toggle('qr-current', row === nearest));
  }

  function updateShoppingList(calc) {
    document.querySelectorAll('#shopping-list .shop-row').forEach(row => {
      const q = row.getAttribute('data-q');
      const qtyEl = row.querySelector('.shop-qty');
      if (!q || q === 'static' || !qtyEl) return;
      if (q === 'main') {
        qtyEl.textContent = `${calc.unitsNeeded} ${unitsDisplay(calc.unitsNeeded)}`;
        return;
      }
      const match = q.match(/^(drinkers|units|servings)([*/])([\d.]+)$/);
      if (!match) return;
      const base = match[1] === 'drinkers' ? calc.drinkers
        : match[1] === 'units' ? calc.unitsNeeded
        : calc.fullServings;
      const factor = parseFloat(match[3]);
      const value = Math.ceil(match[2] === '*' ? base * factor : base / factor);
      const unitText = row.getAttribute('data-unit') || '';
      qtyEl.textContent = `${value} ${unitText}`;
    });

    const buyLabel = document.getElementById('where-to-buy-label');
    if (buyLabel) buyLabel.textContent = `Where to buy ${calc.unitsNeeded} ${unitsDisplay(calc.unitsNeeded)}`;

    const wtbNeed = document.getElementById('wtb-need');
    if (wtbNeed) {
      const unitWord = unitsDisplay(calc.unitsNeeded);
      let line = `You need ${calc.unitsNeeded} ${unitWord}`;
      if (itemData.unit === 'bottles' && calc.unitsNeeded >= 6) {
        const cases = fractionLabel(calc.unitsNeeded / 12);
        line += ` (about ${cases} ${cases === '1' ? 'case' : 'cases'})`;
      }
      wtbNeed.textContent = line;
    }
  }

  let currentGuests = guestCount;
  let currentDuration = eventDuration;
  let displayedGuests = guestCount;

  function applyState(guests, duration, updateUrl) {
    currentGuests = guests;
    currentDuration = duration;
    const calc = recalculate(guests, duration);

    // Answer row
    const answerNumber = document.querySelector('.answer-number');
    if (answerNumber) answerNumber.textContent = calc.unitsNeeded;
    const answerUnit = document.querySelector('.answer-unit');
    if (answerUnit) answerUnit.textContent = `${unitsDisplay(calc.unitsNeeded)} of ${drinkName}`;
    const answerContext = document.querySelector('.answer-context');
    if (answerContext) answerContext.textContent = contextLine(calc, duration);

    // Only-drink and toast lines
    const onlyFigure = document.querySelector('.answer-only-drink .only-drink-figure');
    if (onlyFigure) onlyFigure.textContent = `${calc.onlyUnits} ${unitsDisplay(calc.onlyUnits)}`;
    const onlyPerGuest = document.querySelector('.answer-only-drink .only-drink-per-guest');
    if (onlyPerGuest) onlyPerGuest.textContent = `(${calc.perPersonOnly} ${servingWord} per guest)`;
    if (isChampagne) {
      const toastFigure = document.querySelector('.answer-toast .toast-figure');
      if (toastFigure) toastFigure.textContent = `${calc.toastBottles} bottles`;
    }

    // H1 carries the guest count
    const h1 = document.querySelector('h1');
    if (h1 && h1.textContent.includes(String(displayedGuests))) {
      h1.textContent = h1.textContent.replace(String(displayedGuests), String(guests));
    }
    displayedGuests = guests;

    updateMathLedger(calc, guests, duration);
    updateQuickReference(guests);
    updateShoppingList(calc);

    if (updateUrl) {
      const params = new URLSearchParams(window.location.search);
      if (guests !== guestCount) params.set('guests', String(guests));
      else params.delete('guests');
      if (duration !== eventDuration) params.set('duration', String(duration));
      else params.delete('duration');
      const query = params.toString();
      history.replaceState(null, '', `${window.location.pathname}${query ? `?${query}` : ''}`);
    }
  }

  // Wire the Adjust steppers
  const guestInput = document.getElementById('adjust-guests');
  const hoursInput = document.getElementById('adjust-hours');
  const guestStepper = document.getElementById('adjust-guests-stepper');
  const hoursStepper = document.getElementById('adjust-hours-stepper');
  const GUEST_STEPS = [10, 15, 20, 25, 30, 40, 50, 75, 100, 125, 150, 200, 250, 300];

  function clamp(value, min, max) {
    return Math.min(max, Math.max(min, value));
  }

  function nearestStepIndex(guests) {
    let best = 0;
    let minDiff = Infinity;
    GUEST_STEPS.forEach((value, i) => {
      const diff = Math.abs(value - guests);
      if (diff < minDiff) {
        minDiff = diff;
        best = i;
      }
    });
    return best;
  }

  function setGuests(value, updateUrl = true) {
    const guests = clamp(Math.round(value) || 10, 10, 300);
    if (guestInput) {
      guestInput.value = guests;
      guestInput.setAttribute('aria-valuetext', `${guests} guests`);
    }
    applyState(guests, currentDuration, updateUrl);
  }

  function setHours(value, updateUrl = true) {
    const hours = clamp(Math.round(value) || 1, 1, 6);
    if (hoursInput) {
      hoursInput.value = hours;
      hoursInput.setAttribute('aria-valuetext', `${hours} hours`);
    }
    applyState(currentGuests, hours, updateUrl);
  }

  guestStepper?.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-step]');
    if (!btn) return;
    const direction = btn.dataset.step === 'up' ? 1 : -1;
    const idx = nearestStepIndex(currentGuests);
    setGuests(GUEST_STEPS[clamp(idx + direction, 0, GUEST_STEPS.length - 1)]);
  });

  hoursStepper?.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-step]');
    if (!btn) return;
    setHours(currentDuration + (btn.dataset.step === 'up' ? 1 : -1));
  });

  guestInput?.addEventListener('change', () => setGuests(parseInt(guestInput.value, 10)));
  hoursInput?.addEventListener('change', () => setHours(parseInt(hoursInput.value, 10)));

  // Apply URL parameters on load
  const urlParams = new URLSearchParams(window.location.search);
  const customGuests = parseInt(urlParams.get('guests') || '', 10);
  const customDuration = parseInt(urlParams.get('duration') || '', 10);
  if (!Number.isNaN(customGuests) || !Number.isNaN(customDuration)) {
    if (!Number.isNaN(customDuration)) {
      currentDuration = clamp(customDuration, 1, 6);
      if (hoursInput) hoursInput.value = currentDuration;
    }
    setGuests(Number.isNaN(customGuests) ? guestCount : customGuests, false);
  }
</script>
