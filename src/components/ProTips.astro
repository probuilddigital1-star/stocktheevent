---
/**
 * ProTips.astro - the site's own planning notes as plain ruled rows, with
 * the buying guide as a closing paragraph. These are not quotations and
 * carry no attribution styling.
 */
import PageSection from './PageSection.astro';

interface Props {
  title: string;
  tips: string[];
  guide?: string;
}

const { title, tips, guide } = Astro.props;
---

<PageSection label="Planning notes" title={title}>
  <ul class="tips-list">
    {tips.map((tip) => (
      <li class="tips-row">{tip}</li>
    ))}
  </ul>
  {guide && <p class="tips-guide">{guide}</p>}
</PageSection>

<style>
  .tips-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .tips-row {
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    line-height: 1.55;
  }

  .tips-row:first-child {
    padding-top: 0;
  }

  .tips-guide {
    margin: 16px 0 0;
    color: var(--ink-2);
    line-height: 1.6;
    max-width: 62ch;
  }
</style>
