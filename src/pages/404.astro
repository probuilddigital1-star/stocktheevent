---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found - StockTheEvent"
  description="The page you're looking for doesn't exist. Let's get you back to planning your event."
>
  <section class="container nf-page">
    <span class="num nf-code">404</span>
    <h1 class="nf-h1">This party ended early</h1>
    <p class="nf-note">
      This page does not exist. Let's get you back to the main event.
    </p>

    <div class="nf-actions">
      <a href="/" class="btn-primary">Go to the calculator</a>
      <a href="/calculators/" class="btn-secondary">Browse all calculators</a>
    </div>

    <div class="nf-popular">
      <span class="label nf-popular-head">Popular calculators</span>
      <a href="/wine-for-wedding-100-guests/" class="nf-link">Wine for a 100-guest wedding</a>
      <a href="/beer-for-super-bowl-party-50-guests/" class="nf-link">Beer for a 50-guest Super Bowl party</a>
      <a href="/champagne-for-holiday-party-75-guests/" class="nf-link">Champagne for a 75-guest holiday party</a>
      <a href="/spirits-for-birthday-party-30-guests/" class="nf-link">Spirits for a 30-guest birthday party</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf-page {
    max-width: 34rem;
    padding-top: 56px;
    padding-bottom: 64px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .nf-code {
    font-size: 104px;
    line-height: 0.9;
    font-weight: 600;
    letter-spacing: -0.03em;
    font-stretch: 105%;
  }

  .nf-h1 {
    margin: 0;
    font-size: 34px;
    line-height: 1.1;
  }

  .nf-note {
    margin: 0;
    color: var(--ink-2);
    line-height: 1.6;
  }

  .nf-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 8px;
  }

  .nf-popular {
    display: flex;
    flex-direction: column;
    margin-top: 24px;
  }

  .nf-popular-head {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--ink);
  }

  .nf-link {
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
  }
</style>
